---
/*
  Base site layout: the durable document shell shared by every route.
  Loads the global design foundations, the fonts, the shared header + footer,
  and wires the mobile-nav toggle. Page content is provided via <slot /> and
  wrapped in <main>. This layout is intentionally chrome-only — it imposes no
  section order or narrative structure on the page inside it.

  Props:
    - title:       full <title> text for the route
    - description: meta description for the route
    - noindex:     when true, emit robots noindex (unlisted utility routes)
*/
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <dialog id="live-site-modal" class="live-site-modal">
      <button type="button" class="live-site-modal-close" aria-label="Close preview">×</button>
      <iframe id="live-site-modal-frame" title="Live site preview" loading="lazy"></iframe>
    </dialog>

    <script>
      const liveModal = document.getElementById("live-site-modal");
      const liveFrame = document.getElementById("live-site-modal-frame");
      const liveModalClose = liveModal && liveModal.querySelector(".live-site-modal-close");

      if (liveModal && liveFrame && liveModalClose) {
        document.querySelectorAll(".js-live-site").forEach((trigger) => {
          trigger.addEventListener("click", (event) => {
            const url = trigger.dataset.liveUrl;
            if (!url) return;
            event.preventDefault();
            liveFrame.src = url;
            liveModal.showModal();
          });
        });

        liveModalClose.addEventListener("click", () => liveModal.close());
        liveModal.addEventListener("click", (event) => {
          if (event.target === liveModal) liveModal.close();
        });
        liveModal.addEventListener("close", () => {
          liveFrame.src = "about:blank";
        });
      }

      const toggle = document.querySelector(".nav-toggle");
      const menu = document.getElementById("mobile-menu");
      const carets = document.querySelectorAll(".mobile-caret");

      const collapseSubmenus = () => {
        carets.forEach((btn) => {
          const sub = document.getElementById(btn.getAttribute("aria-controls"));
          btn.setAttribute("aria-expanded", "false");
          if (sub) sub.hidden = true;
        });
      };

      if (toggle && menu) {
        const setOpen = (open) => {
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
          menu.hidden = !open;
          if (!open) collapseSubmenus();
        };
        toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
        menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
        document.addEventListener("keydown", (e) => {
          if (e.key !== "Escape") return;
          setOpen(false);
          if (document.activeElement && document.activeElement.closest(".nav-dropdown")) {
            document.activeElement.blur();
          }
        });
        window.matchMedia("(min-width:801px)").addEventListener("change", (e) => { if (e.matches) setOpen(false); });
      }

      carets.forEach((btn) => {
        const sub = document.getElementById(btn.getAttribute("aria-controls"));
        if (!sub) return;
        btn.addEventListener("click", () => {
          const open = btn.getAttribute("aria-expanded") !== "true";
          btn.setAttribute("aria-expanded", String(open));
          sub.hidden = !open;
        });
      });
    </script>
  </body>
</html>
