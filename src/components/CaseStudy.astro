---
/*
  CaseStudy: the shared long-form layout for every /work/<case> detail page.
  Established-world extension of the homepage's "Grounded Workshop" - Warm Cream and
  white feature bands, an Espresso Black close, Playfair section headings on Lato
  text, and one Burnt Terracotta CTA. Structure
  follows the Framer case-study template: hero (niche + optional live link + H1 +
  full-bleed image), a Who / What changed summary band, then three alternating
  product-feature sections, an optional real-quote band, and a dark
  close with the CTA and a next-project link. All four case pages pass data into this
  one component so the layout and CSS live in exactly one place.

  Props:
    niche, location   - the eyebrow ("Family Law", "Raleigh")
    title             - the case H1 (the transformation line)
    liveUrl           - optional; when present, "See Live Site" opens it in the shared
                        live-site preview modal (see BaseLayout.astro); else renders
                        pending (non-interactive) in the same navbar-CTA style
    heroImage         - optional src; when null a placeholder panel renders instead
    heroAlt           - alt text for the hero image
    who, whatChanged  - the two summary-band values
    features          - exactly three { title, body, image?, video?, presentation, alt } product features
    quote             - optional { text, cite }; omitted entirely when no real quote
    next              - { label, href } for the next-project link
*/
const {
  niche,
  location,
  title,
  liveUrl,
  heroImage,
  heroAlt,
  who,
  whatChanged,
  features = [],
  quote,
  next,
} = Astro.props;
---

<article class="case">
  <section class="section case-hero">
    <h1>{title}</h1>
    <div class="case-hero-top">
      {liveUrl
        ? <button type="button" class="live-cta js-live-site" data-live-url={liveUrl}>See Live Site</button>
        : <span class="live-cta is-pending" aria-disabled="true" title="Live site pending">See Live Site</span>}
    </div>
    <div class="case-hero-visual">
      {heroImage
        ? <img src={heroImage} alt={heroAlt} width="1200" height="620" />
        : <div class="ph-panel" role="img" aria-label={`${title} - live-site capture pending`}><span>{location ? `${niche} · ${location}` : niche}</span><small>Live-site capture pending</small></div>}
    </div>
  </section>

  <div class="summary">
    <div class="summary-inner">
      <div><p class="summary-label">Who</p><p class="summary-value">{who}</p></div>
      <div><p class="summary-label">What changed</p><p class="summary-value">{whatChanged}</p></div>
    </div>
  </div>

  <div class="feature-sequence">
    {features.map((feature) => (
      <section class="feature-row">
        <div class="feature-copy">
          <h2>{feature.title}</h2>
          <p>{feature.body}</p>
        </div>
        <figure
          class:list={["feature-media", { "feature-media--mobile": feature.presentation === "mobile" }]}
          data-pointer-tilt={feature.image && feature.mediaKind === "browser" ? "" : undefined}
        >
          <div class="feature-media-inner">
            {feature.video
              ? <video
                  class="feature-video"
                  data-product-video
                  src={feature.video}
                  aria-label={feature.alt}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                ></video>
              : feature.image
              ? <img src={feature.image.src ?? feature.image} alt={feature.alt} loading="lazy" width="760" height="570" />
              : <div class="feature-placeholder" role="img" aria-label={`${feature.alt} - product image pending`}>
                  <span>{feature.title}</span>
                  <small>Product image pending</small>
                </div>}
          </div>
        </figure>
      </section>
    ))}
  </div>

  {quote && (
    <div class="quote-band">
      <blockquote>
        <p class="quote-text">{quote.text}</p>
        <cite>{quote.cite}</cite>
      </blockquote>
    </div>
  )}

  <section class="close-band">
    <h2>Facing something similar?</h2>
    <p>Send a message about your business. You&rsquo;ll hear back from me, not a sales team, within a day.</p>
    <a class="primary-button" href="/contact">Get in Touch</a>
    <p class="next-link">Next project: <a href={next.href}>{next.label} &rarr;</a></p>
  </section>
</article>

<style>
  /* Route-specific composition for every case page. Tokens + chrome are global. */
  /* ---- Hero ---- */
  .section.case-hero {
    max-width: 1100px;
    padding-top: clamp(48px, 6vw, 92px);
    padding-bottom: clamp(40px, 4.5vw, 72px);
  }
  .case-hero-top {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  /* Navbar CTA style, replicated 1:1 (see src/styles/global.css .nav-cta). */
  .live-cta {
    background: var(--espresso);
    color: #fff;
    border: 1px solid var(--espresso);
    border-radius: 7px;
    padding: 13px 19px;
    font-size: 15px;
    font-family: inherit;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .live-cta:hover { background: #33241b; }
  .live-cta:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }
  .live-cta.is-pending { opacity: 0.5; cursor: default; }
  .case-hero h1 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 4.6vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 18px 0 40px;
    max-width: 20ch;
  }
  .case-hero-visual img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid var(--line);
  }
  .ph-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    aspect-ratio: 4 / 3;
    background: var(--oat);
    border: 1px solid var(--line);
    border-radius: 16px;
    text-align: center;
    padding: 24px;
  }
  .ph-panel span {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 24px;
    color: var(--espresso);
  }
  .ph-panel small {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #655b54;
  }

  /* ---- Summary band ---- */
  .summary { background: var(--white); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .summary-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: clamp(32px, 4vw, 44px) 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
  }
  .summary-label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6d635c;
    margin: 0 0 10px;
  }
  .summary-value {
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--espresso);
    margin: 0;
  }

  /* ---- Alternating product features ---- */
  .feature-sequence {
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .feature-row {
    width: min(1160px, calc(100% - 80px));
    margin: 0 auto;
    padding: clamp(58px, 7vw, 92px) 0;
    display: grid;
    grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1.28fr);
    align-items: center;
    gap: clamp(48px, 7vw, 112px);
    border-top: 1px solid var(--line);
  }
  .feature-row:nth-child(even) {
    grid-template-columns: minmax(0, 1.28fr) minmax(240px, 0.72fr);
  }
  .feature-row:nth-child(even) .feature-media { grid-column: 1; grid-row: 1; }
  .feature-row:nth-child(even) .feature-copy { grid-column: 2; grid-row: 1; }
  .feature-copy { max-width: 31rem; }
  .feature-copy h2 {
    font: 500 clamp(32px, 3.1vw, 40px)/1.12 "Playfair Display", Georgia, serif;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--espresso);
    margin: 0 0 18px;
  }
  .feature-copy p {
    max-width: 48ch;
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
  }
  .feature-media {
    position: relative;
    margin: 0;
  }
  .feature-media[data-pointer-tilt] {
    perspective: 900px;
  }
  .feature-media[data-pointer-tilt] .feature-media-inner {
    transform-style: preserve-3d;
    transform: translate3d(var(--pointer-x, 0px), var(--pointer-y, 0px), 0)
      rotateX(var(--pointer-rx, 0deg)) rotateY(var(--pointer-ry, 0deg));
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .feature-media[data-pointer-tilt].is-pointer-active .feature-media-inner {
    will-change: transform;
    transition-duration: 70ms;
  }
  .feature-media img,
  .feature-media video {
    display: block;
    width: 100%;
    height: auto;
  }
  .feature-media--mobile .feature-media-inner {
    width: min(58%, 330px);
    margin-inline: auto;
  }
  .feature-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-sizing: border-box;
    background: var(--oat);
    border: 1px solid var(--line);
    padding: 28px;
    text-align: center;
  }
  .feature-placeholder span {
    max-width: 18ch;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(20px, 2.2vw, 32px);
    line-height: 1.2;
    color: var(--espresso);
  }
  .feature-placeholder small {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #655b54;
  }

  /* ---- Quote band ---- */
  .quote-band { background: var(--white); border-top: 1px solid var(--line); }
  .quote-band blockquote {
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(72px, 9vw, 120px) 40px;
    text-align: center;
  }
  .quote-text {
    font-family: "Playfair Display", Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--espresso);
    margin: 0;
  }
  .quote-band cite {
    display: block;
    font-style: normal;
    font-size: 14px;
    color: #6d635c;
    margin-top: 24px;
  }

  /* ---- Close band (dark) ---- */
  .close-band {
    background: var(--espresso);
    color: #fff;
    text-align: center;
    padding: clamp(88px, 10vw, 125px) 24px clamp(72px, 8vw, 100px);
  }
  .close-band h2 {
    font: 500 clamp(32px, 3.4vw, 40px)/1.15 "Playfair Display", serif;
    letter-spacing: -0.035em;
    margin: 0 0 16px;
  }
  .close-band > p {
    max-width: 560px;
    margin: 0 auto 32px;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.6;
    font-size: 20px;
  }
  .next-link {
    margin: 44px 0 0;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
  }
  .next-link a { display: inline-block; color: #fff; font-weight: 700; }
  @media (prefers-reduced-motion: no-preference) {
    .next-link a { transition: transform 0.2s ease; }
    .next-link a:hover, .next-link a:focus-visible { transform: translateX(4px); }
  }

  /* ---- Motion: hero load fade-up + gated scroll reveal ---- */
  @media (prefers-reduced-motion: no-preference) {
    .case-hero > * { opacity: 0; animation: case-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .case-hero h1 { animation-delay: 0.06s; }
    .case-hero-visual { animation-delay: 0.14s; }
  }
  @keyframes case-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  :global(.reveal) .rv {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .rv.in { opacity: 1; transform: none; }

  /* ---- Responsive ---- */
  @media (max-width: 800px) {
    .summary-inner { grid-template-columns: 1fr; gap: 24px; }
    .summary-value { font-size: 16px; }
    .feature-row,
    .feature-row:nth-child(even) {
      width: min(100% - 40px, 620px);
      padding: 56px 0;
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .feature-row:nth-child(even) .feature-media,
    .feature-row:nth-child(even) .feature-copy {
      grid-column: 1;
      grid-row: auto;
    }
    .feature-copy,
    .feature-row:nth-child(even) .feature-copy { order: 1; }
    .feature-media,
    .feature-row:nth-child(even) .feature-media { order: 2; }
    .feature-copy h2 { margin-bottom: 14px; }
    .feature-media[data-pointer-tilt] { perspective: none; }
    .feature-media[data-pointer-tilt] .feature-media-inner { transform: none; transition: none; }
    .close-band > p { font-size: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-media[data-pointer-tilt] { perspective: none; }
    .feature-media[data-pointer-tilt] .feature-media-inner { transform: none; transition: none; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (reduce.matches) {
    document.querySelectorAll("video[data-product-video]").forEach((video) => {
      video.pause();
      video.removeAttribute("autoplay");
    });
  }
  if (!reduce.matches) {
    document.documentElement.classList.add("reveal");
    const els = document.querySelectorAll(".rv, .stagger");
    const show = (el) => el.classList.add("in");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { show(entry.target); io.unobserve(entry.target); }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden if the observer can't fire
      // (background tab, headless renderer, throttled JS). Reveal all after a beat.
      setTimeout(() => els.forEach(show), 1500);
    } else {
      els.forEach(show);
    }
  }

  const canTilt = window.matchMedia("(hover: hover) and (pointer: fine)");
  if (!reduce.matches && canTilt.matches) {
    document.querySelectorAll<HTMLElement>("[data-pointer-tilt]").forEach((target) => {
      let pointerFrame = 0;
      let pointerX = 0;
      let pointerY = 0;

      const renderPointerTilt = () => {
        pointerFrame = 0;
        target.style.setProperty("--pointer-rx", `${pointerY * 2.5}deg`);
        target.style.setProperty("--pointer-ry", `${pointerX * -2.5}deg`);
        target.style.setProperty("--pointer-x", `${pointerX * -3}px`);
        target.style.setProperty("--pointer-y", `${pointerY * -3}px`);
      };

      const queuePointerTilt = () => {
        if (!pointerFrame) pointerFrame = requestAnimationFrame(renderPointerTilt);
      };

      target.addEventListener("pointermove", (event) => {
        const rect = target.getBoundingClientRect();
        pointerX = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width) * 2 - 1));
        pointerY = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height) * 2 - 1));
        target.classList.add("is-pointer-active");
        queuePointerTilt();
      });

      const resetPointerTilt = () => {
        if (pointerFrame) cancelAnimationFrame(pointerFrame);
        pointerFrame = 0;
        pointerX = 0;
        pointerY = 0;
        target.classList.remove("is-pointer-active");
        renderPointerTilt();
      };

      target.addEventListener("pointerleave", resetPointerTilt);
      target.addEventListener("pointercancel", resetPointerTilt);
    });
  }
</script>
