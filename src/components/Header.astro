---
/*
  Site header: wordmark, primary nav, desktop CTA, and the mobile menu.
  Durable chrome shared across every route. Styling lives in
  src/styles/global.css (.site-header / .nav-cta / .nav-toggle / .mobile-menu);
  the toggle behavior is wired in BaseLayout's script.
*/
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Proudly Sites home"><img src="/images/proudly-logo.png" alt="Proudly Sites" /></a>
  <nav aria-label="Primary navigation">
    <a href="/work">Work</a>
    <a href="/services">Services</a>
    <a href="/#pricing">Pricing</a>
    <a href="/#blog">Blog</a>
    <a href="/about">About</a>
  </nav>
  <a class="nav-cta" href="/contact">Get in Touch</a>
  <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
    <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/></svg>
    <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
  </button>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <a href="/work">Work</a>
    <a href="/services">Services</a>
    <a href="/#pricing">Pricing</a>
    <a href="/#blog">Blog</a>
    <a href="/about">About</a>
    <a class="primary-button" href="/contact">Get in Touch</a>
  </div>
</header>
