---
/*
  Site footer: brand/contact column plus link columns and the copyright line.
  Durable chrome shared across every route. Styling lives in
  src/styles/global.css (footer / .footer-grid / .footer-bottom).
*/
import { services } from "../data/services";
import { studios } from "../data/studios";
import { getCollection } from "astro:content";

const caseStudies = (await getCollection("caseStudies", ({ data }) => data.status === "published"))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => ({ title: data.title, href: `/work/${data.slug}` }));
---
<footer>
  <div class="footer-grid">
    <div class="footer-brand"><a class="footer-logo" href="/"><img src="/images/proudly-logo.png" alt="Proudly Sites" /></a><p>Contact</p><a href="tel:+19196348169">919-634-8169</a><a href="mailto:alex@proudlysites.com">alex@proudlysites.com</a></div>
    <div><h3>Site</h3><a href="/">Home</a><a href="/about">About</a><a href="/contact">Contact</a></div>
    <div><h3>Services</h3>{services.map((s) => <a href={s.href}>{s.title}</a>)}</div>
    <div><h3>Studio</h3>{studios.map((s) => <a href={s.href}>{s.title}</a>)}</div>
    <div><h3>Case Studies</h3>{caseStudies.map((c) => <a href={c.href}>{c.title}</a>)}</div>
  </div>
  <div class="footer-bottom"><span>© 2026 Proudly Sites. Raleigh, NC.</span></div>
</footer>
