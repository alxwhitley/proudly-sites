---
/*
  Contact route (/contact) — Persuade surface, extension of the homepage's
  "Grounded Workshop" world. Human/contact ledger on the left, a single flat
  form card on the right; the system's one terracotta stacked-shadow CTA is
  spent on Send. Form posts to Web3Forms (host-agnostic, public access key);
  JS enhances to an inline success state, native POST is the no-JS fallback.
  Route-specific composition lives here; shared chrome + tokens come from
  BaseLayout / global.css. See .impeccable/surfaces for the surface brief.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import InquiryForm from "../components/InquiryForm.astro";
---

<BaseLayout
  title="Contact · Proudly Sites"
  description="Work directly with Alex Whitley, the one person who designs, writes, and builds your Proudly site. Tell me about your business and where your current site is holding you back."
>
  <section class="section contact">
    <!--
      THESIS: reaching a real, accountable person, not a support queue; refuses the
        generic centered-form-on-a-slab contact template.
      OWN-WORLD: Warm Cream ground, Fraunces display + Lato, one flat white form card
        with a hairline edge, the lone terracotta stacked-shadow CTA on Send.
      STORY: a cautious founder sees Alex's face and direct line, believes one person
        will own the work, and sends a short qualified message.
      FIRST VIEWPORT: full-width Fraunces H1 + lead, then human ledger (portrait, name,
        email/phone/studio) left and the form card right; Send sits at the card's foot.
      FORM: two-column ledger + card, established-world extension (no concept roll).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
    -->
    <header class="contact-head">
      <h1>Let&rsquo;s talk about your website.</h1>
      <p class="lead">You&rsquo;ll be working with me directly, from the first message through launch. Tell me about your business and where your current site is holding you back, and I&rsquo;ll take it from there.</p>
    </header>

    <div class="contact-grid">
      <aside class="contact-aside">
        <div class="person">
          <img class="person-photo" src="/images/alex-whitley.jpeg" width="112" height="112" alt="Alex Whitley, founder of Proudly Sites" />
          <div class="person-id">
            <p class="person-name">Alex Whitley</p>
            <p class="person-role">Founder, Proudly Sites</p>
          </div>
        </div>

        <ul class="methods">
          <li>
            <span class="method-label">Email</span>
            <a href="mailto:alex@proudlysites.com">alex@proudlysites.com</a>
          </li>
          <li>
            <span class="method-label">Call</span>
            <a href="tel:+19196348169">(919) 634-8169</a>
          </li>
          <li>
            <span class="method-label">Studio</span>
            <span class="method-value">Raleigh, North Carolina</span>
          </li>
        </ul>

        <div class="assurance">
          <h2>What happens next</h2>
          <p>I read every message myself. If it looks like a fit, we&rsquo;ll set up a short call to talk through your site and where it&rsquo;s falling short.</p>
        </div>
      </aside>

      <div class="contact-form-card">
        <h2 class="form-title">Send a message</h2>

        <InquiryForm subject="New inquiry from proudlysites.com" fromName="Proudly Sites website">
          <div class="field">
            <label for="cf-name">Name <span class="req" aria-hidden="true">*</span></label>
            <input id="cf-name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="cf-email">Email <span class="req" aria-hidden="true">*</span></label>
              <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
            </div>
            <div class="field">
              <label for="cf-phone">Phone <span class="optional">optional</span></label>
              <input id="cf-phone" name="phone" type="tel" autocomplete="tel" placeholder="(919) 000-0000" />
            </div>
          </div>

          <div class="field">
            <label for="cf-need">What do you need? <span class="req" aria-hidden="true">*</span></label>
            <select id="cf-need" name="need" required>
              <option value="" disabled selected>Choose one</option>
              <option value="A new website">A new website</option>
              <option value="A redesign of my current site">A redesign of my current site</option>
              <option value="Not sure yet, let's talk">Not sure yet, let&rsquo;s talk</option>
            </select>
          </div>

          <div class="field">
            <label for="cf-message">Message <span class="req" aria-hidden="true">*</span></label>
            <textarea id="cf-message" name="message" rows="5" required placeholder="Tell me about your business and what you're looking for."></textarea>
          </div>
        </InquiryForm>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Route-specific composition for /contact. Tokens + chrome are global. */
  .section.contact {
    padding-top: 120px;
    padding-bottom: 140px;
    max-width: 1180px;
  }

  .contact-head {
    max-width: 620px;
    margin-bottom: 56px;
  }
  .contact-head h1 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
  }
  .contact-head .lead {
    font-size: 20px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--muted);
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 60px;
    align-items: start;
  }

  /* ---- Left: the human ledger ---- */
  .contact-aside { padding-top: 6px; }
  .person { display: flex; align-items: center; gap: 16px; margin-bottom: 34px; }
  .person-photo {
    width: 72px; height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  .person-name { font-weight: 700; font-size: 16px; margin: 0 0 3px; }
  .person-role { font-size: 14px; color: #6d635c; margin: 0; }

  .methods { list-style: none; margin: 0; padding: 0; }
  .methods li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .methods li:last-child { border-bottom: 1px solid var(--line); }
  .method-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6d635c;
  }
  .methods a, .method-value { font-size: 16px; color: var(--espresso); }
  .methods a { display: inline-block; padding: 4px 0; margin: -4px 0; }
  @media (prefers-reduced-motion: no-preference) {
    .methods a { transition: transform 0.18s ease; }
    .methods a:hover, .methods a:focus-visible { transform: translateX(4px); }
  }

  .assurance { margin-top: 32px; }
  .assurance h2 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 20px;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .assurance p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 30ch;
  }

  /* ---- Right: the form card ---- */
  .contact-form-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 40px;
  }
  .form-title {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
  }

  /* ---- Motion: one authored load moment ---- */
  @media (prefers-reduced-motion: no-preference) {
    .contact-head, .contact-aside, .contact-form-card {
      animation: contact-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .contact-aside { animation-delay: 0.07s; }
    .contact-form-card { animation-delay: 0.13s; }
  }
  @keyframes contact-rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  /* ---- Responsive ---- */
  @media (max-width: 800px) {
    .section.contact { padding-top: 64px; padding-bottom: 80px; }
    .contact-head { margin-bottom: 36px; }
    .contact-head .lead { font-size: 16px; }
    .contact-grid { display: flex; flex-direction: column; align-items: stretch; gap: 32px; }
    .contact-form-card { padding: 26px 22px; }
  }
</style>
