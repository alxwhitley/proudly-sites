---
/*
  Services / Branding (/services/branding) - Persuade surface, established-world
  extension of the homepage's "Grounded Workshop." No new world, no concept roll.
  Picture-forward proof page (services-copy.md pattern) rebuilt on the live shared
  system (BaseLayout / global.css tokens + chrome). Structure: hero (outcome H1),
  real client proof rows (alternating image + decision caption), a two-card
  "Bigger Picture" bridge to the other two services, and the homepage closing CTA
  reused verbatim. This file is the service-detail template; web-design and
  ai-and-search-visibility clone its structure with their own copy.
  See .impeccable/surfaces/src-pages-services.md for the cluster brief.
*/
import BaseLayout from "../../layouts/BaseLayout.astro";

// Real client proof. Images are real existing assets where available; the After
// Hours slot has no local asset and the Framer CMS was unreachable this session,
// so it uses an on-palette placeholder panel (logged to assets.md + morning queue).
const proof = [
  {
    client: "Smith Cash Family Law",
    image: "/images/smith-cash.jpeg",
    imageAlt: "The Smith Cash Family Law website, warm and calm rather than stuffy",
    caption:
      "They were already known for honest, steady counsel. The brand had to feel that way before a word was read: warm, not stuffy, calm instead of loud.",
  },
  {
    client: "Legacy Renovations",
    image: "/images/legacy-renovations.jpeg",
    imageAlt: "A finished Legacy Renovations kitchen, the brand kept quiet so the work leads",
    caption:
      "The work speaks first here, so the brand gets out of its way. Restrained type and a quiet palette let the finished kitchens carry the page.",
  },
  {
    client: "After Hours Ministry",
    image: null,
    caption:
      "A personal ministry needed a voice that felt like the person behind it, not a template. The brand reads calm and direct, the same way the ministry does.",
  },
];

// The other two services, for the Bigger Picture bridge (one-person differentiator).
const siblings = [
  { n: "01", title: "Web Design", href: "/services/web-design", teaser: "The design that makes the right people stop and stay." },
  { n: "02", title: "Search & AI Visibility", href: "/services/ai-and-search-visibility", teaser: "Built to be found and quoted when buyers search Google and ask AI." },
];
---

<BaseLayout
  title="Branding · Proudly Sites"
  description="Brand identity for reputation-led service businesses: color, type, and voice built around how your clients actually decide, proven with real client work."
>
  <section class="section svc-hero">
    <!--
      THESIS: prove the branding claim with real client work, refuse the deliverable-list "what's included" template.
      OWN-WORLD: the homepage's Grounded Workshop, inherited whole - Warm Cream ground, Espresso Black close, Playfair headings on Lato text, Honey Gold decorating only, one Burnt Terracotta stacked-shadow CTA.
      STORY: a referred founder who cares most about the brand sees three real brands in context, understands one person carries brand through design and build, then takes the ask.
      FIRST VIEWPORT: eyebrow, outcome H1, one-line lead; the primary action waits at the close.
      FORM: established-world extension (no concept roll); service-detail template for the cluster.
    -->
    <p class="eyebrow">Branding</p>
    <h1>A Brand People Trust Before You Say a Word</h1>
    <p class="lead">Color, type, and voice built around how your clients actually decide, so the right person feels they are in good hands the moment they land.</p>
  </section>

  <div class="surface-white">
    <section class="section proof">
      <h2 class="eyebrow rv">The Proof</h2>
      <div class="proof-rows">
        {proof.map((item, i) => (
          <article class:list={["proof-row", "rv", { reverse: i % 2 === 1 }]}>
            <div class="proof-visual">
              {item.image
                ? <img src={item.image} alt={item.imageAlt} loading="lazy" width="720" height="480" />
                : <div class="ph-panel" role="img" aria-label={`${item.client} - live-site capture pending`}><span>{item.client}</span><small>Live-site capture pending</small></div>}
            </div>
            <div class="proof-copy">
              <p class="proof-client">{item.client}</p>
              <p class="proof-caption">{item.caption}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <section class="section bridge rv">
    <p class="eyebrow">How It Fits</p>
    <h2>A brand only holds if the rest carries it through</h2>
    <p class="bridge-body">The color and voice are where it starts, but a brand falls apart the moment the site design or the build stops honoring it. That is the advantage of one person doing all three. The brand you approve is the brand that reaches your clients, because nothing gets handed to another team to reinterpret.</p>
    <div class="bridge-cards">
      {siblings.map((s) => (
        <a class="bridge-card" href={s.href}>
          <span class="bridge-num">{s.n}</span>
          <span class="bridge-arrow" aria-hidden="true">&#8599;</span>
          <h3>{s.title}</h3>
          <p>{s.teaser}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="closing-cta">
    <h2>Your Work Deserves a Website That<br />Proves It</h2>
    <p>Send a message about your business. You&rsquo;ll hear back from me, not a sales team, within a day, with honest advice on whether a new site is even the right move.</p>
    <a class="primary-button" href="/contact">Get in Touch</a>
    <small>Live in weeks, not months.</small>
  </section>
</BaseLayout>

<style>
  /* Route-specific composition for the service-detail template. Tokens + chrome
     are global; this world is inherited from /about and the homepage. */

  .surface-white { background: var(--white); }

  /* ---- Shared eyebrow (world-consistent section tag, gold dot) ---- */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6d635c;
    margin: 0 0 18px;
  }
  h2.eyebrow { display: flex; }
  .eyebrow::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  /* ---- Hero ---- */
  .section.svc-hero {
    max-width: 900px;
    padding-top: clamp(56px, 7vw, 104px);
    padding-bottom: clamp(48px, 5vw, 84px);
  }
  .svc-hero h1 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 4.6vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0 0 22px;
    max-width: 16ch;
  }
  .svc-hero .lead {
    font-size: 20px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--muted);
    margin: 0;
    max-width: 40rem;
  }

  /* ---- Proof rows (alternating image + decision caption) ---- */
  .section.proof > .eyebrow { display: inline-flex; margin-bottom: 54px; }
  .proof-rows { display: flex; flex-direction: column; gap: clamp(48px, 6vw, 88px); }
  .proof-row {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 4.5vw, 70px);
    align-items: center;
  }
  .proof-row.reverse .proof-visual { order: 2; }
  .proof-visual {
    background: var(--sand);
    border-radius: 16px;
    padding: clamp(20px, 2.4vw, 32px);
  }
  .proof-visual img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 10px;
  }
  .ph-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    aspect-ratio: 3 / 2;
    background: var(--oat);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-align: center;
    padding: 24px;
  }
  .ph-panel span {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 20px;
    color: var(--espresso);
  }
  .ph-panel small {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6d635c;
  }
  .proof-client {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6d635c;
    margin: 0 0 14px;
  }
  .proof-caption {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--espresso);
    margin: 0;
    max-width: 32ch;
  }

  /* ---- Bigger Picture bridge ---- */
  .section.bridge { max-width: 1000px; }
  .bridge h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 3.6vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    margin: 0 0 22px;
    max-width: 20ch;
  }
  .bridge-body {
    font-size: 20px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--muted);
    margin: 0 0 48px;
    max-width: 40rem;
  }
  .bridge-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .bridge-card {
    position: relative;
    display: block;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 30px 30px 34px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .bridge-card:hover { transform: translateY(-2px); border-color: var(--clay); }
  .bridge-num {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #6d635c;
  }
  .bridge-arrow {
    position: absolute;
    top: 26px;
    right: 28px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--terracotta);
    font-size: 16px;
  }
  .bridge-card h3 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 18px 0 10px;
  }
  .bridge-card p { font-size: 16px; line-height: 1.55; color: var(--muted); margin: 0; max-width: 30ch; }

  /* ---- Closing CTA (homepage instance, verbatim) ---- */
  .closing-cta { min-height: 520px; background: var(--espresso); color: #fff; text-align: center; padding: 125px 24px 115px; }
  .closing-cta h2 { font: 500 clamp(32px, 3.4vw, 40px)/1.15 "Playfair Display", serif; letter-spacing: -0.035em; margin-bottom: 22px; }
  .closing-cta p { max-width: 610px; margin: 0 auto 30px; color: rgba(255, 255, 255, 0.72); line-height: 1.6; font-size: 20px; }
  .closing-cta > small { display: block; color: rgba(255, 255, 255, 0.6); margin-top: 22px; font-size: 14px; }

  /* ---- Motion: hero load fade-up + gated scroll reveal ---- */
  @media (prefers-reduced-motion: no-preference) {
    .svc-hero > * { opacity: 0; animation: svc-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .svc-hero h1 { animation-delay: 0.06s; }
    .svc-hero .lead { animation-delay: 0.12s; }
  }
  @keyframes svc-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  :global(.reveal) .rv {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .rv.in { opacity: 1; transform: none; }

  /* ---- Responsive ---- */
  @media (max-width: 800px) {
    .proof-row { grid-template-columns: 1fr; gap: 22px; }
    .proof-row.reverse .proof-visual { order: 0; }
    .proof-caption { font-size: 20px; }
    .svc-hero .lead, .bridge-body { font-size: 16px; }
    .bridge-cards { grid-template-columns: 1fr; }
    .closing-cta { min-height: 470px; padding: 100px 22px; }
    .closing-cta p { font-size: 16px; }
  }

  @media (min-width: 801px) {
    .closing-cta { min-height: 520px; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduce.matches) {
    document.documentElement.classList.add("reveal");
    const els = document.querySelectorAll(".rv, .stagger");
    const show = (el) => el.classList.add("in");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { show(entry.target); io.unobserve(entry.target); }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden if the observer can't fire
      // (background tab, headless renderer, throttled JS). Reveal all after a beat.
      setTimeout(() => els.forEach(show), 1500);
    } else {
      els.forEach(show);
    }
  }
</script>
