---
/*
  Services index (/services) - Persuade surface, established-world extension of the
  homepage's "Grounded Workshop." Reshaped from the identical 3-card grid into a
  thesis-led EDITORIAL INDEX (Impeccable shape brief, 2026-08-07): a dominant Playfair
  thesis carries the one-person message, then the three services are hairline-divided
  full-width rows (name + one-line outcome + terracotta arrow), each whole row a link
  to its detail page. No cards, no glyph chips, no per-section eyebrow, no numbering.
  Identity locked: tokens, Playfair/Lato, the one terracotta accent, and the dark
  closing CTA are inherited unchanged from the shared system.
  See .impeccable/surfaces/src-pages-services.md for the cluster brief.
*/
import BaseLayout from "../../layouts/BaseLayout.astro";

// Outcome one-liners reuse each detail page's approved H1 outcome, for consistency.
const services = [
  {
    title: "Branding",
    href: "/services/branding",
    outcome: "A brand people trust before you say a word.",
  },
  {
    title: "Web Design",
    href: "/services/web-design",
    outcome: "Design that makes the right people stop and stay.",
  },
  {
    title: "Search & AI Visibility",
    href: "/services/ai-and-search-visibility",
    outcome: "Built to be found when someone searches for you.",
  },
];
---

<BaseLayout
  title="Services · Proudly Sites"
  description="Branding, web design, and search & AI visibility for reputation-led service businesses, handled in-house by one person in Raleigh, North Carolina."
>
  <section class="section services-hero">
    <!--
      THESIS: three services are three parts of one job carried by one person; refuse the interchangeable "à la carte tiles" card grid.
      OWN-WORLD: the homepage's Grounded Workshop, inherited whole - Warm Cream ground, Espresso Black close, Playfair headings on Lato text, one Burnt Terracotta accent, one stacked-shadow CTA.
      STORY: a founder weighing what they need reads one confident statement, scans three plainly-named parts of one job, then opens the part that fits or takes the ask.
      FORM: editorial index (masthead thesis + hairline-ruled service rows), established-world extension, no concept roll.
    -->
    <h1>One person. Your brand, your<br />site, and how you&rsquo;re found.</h1>
    <p class="lead">Brand, site design, and how you&rsquo;re found, handled by one person, so the pieces fit and nothing gets handed off to be reinterpreted.</p>
  </section>

  <section class="section svc-index-wrap">
    <ul class="svc-index stagger">
      {services.map((s) => (
        <li>
          <a class="svc-row" href={s.href}>
            <span class="svc-row-main">
              <span class="svc-name">{s.title}</span>
              <span class="svc-outcome">{s.outcome}</span>
            </span>
            <span class="svc-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="closing-cta">
    <h2>Your Work Deserves a Website That<br />Proves It</h2>
    <p>Send a message about your business. You&rsquo;ll hear back from me, not a sales team, within a day, with honest advice on whether a new site is even the right move.</p>
    <a class="primary-button" href="/contact">Get in Touch</a>
    <small>Live in weeks, not months.</small>
  </section>
</BaseLayout>

<style>
  /* Route-specific composition (editorial index). Tokens + chrome are global; the
     world is inherited from the homepage and the service-detail template. */

  /* ---- Hero: thesis is the dominant element, no eyebrow ---- */
  .section.services-hero {
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: clamp(28px, 3.5vw, 48px);
  }
  .services-hero h1 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0 0 24px;
    max-width: 20ch;
  }
  .services-hero .lead {
    font-size: 20px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--muted);
    margin: 0;
    max-width: 40rem;
  }

  /* ---- Editorial service rows (hairline-ruled, whole row is the link) ---- */
  .section.svc-index-wrap {
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(72px, 9vw, 140px);
  }
  .svc-index {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 980px;
    border-top: 1px solid var(--line);
  }
  .svc-index li { border-bottom: 1px solid var(--line); }
  .svc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(20px, 4vw, 64px);
    padding: clamp(28px, 3.4vw, 44px) 8px clamp(28px, 3.4vw, 44px) 0;
    transition: background-color 0.3s ease;
  }
  .svc-row:hover,
  .svc-row:focus-visible {
    background-color: rgba(26, 15, 10, 0.025);
  }
  .svc-row-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .svc-row:hover .svc-row-main,
  .svc-row:focus-visible .svc-row-main { transform: translateX(8px); }
  .svc-name {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(24px, 2.9vw, 32px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--espresso);
  }
  .svc-outcome {
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--muted);
    max-width: 46ch;
  }
  .svc-arrow {
    flex: none;
    color: var(--terracotta);
    font-size: 24px;
    line-height: 1;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .svc-row:hover .svc-arrow,
  .svc-row:focus-visible .svc-arrow { transform: translateX(7px); }

  /* ---- Closing CTA (homepage instance, verbatim) ---- */
  .closing-cta { min-height: 520px; background: var(--espresso); color: #fff; text-align: center; padding: 125px 24px 115px; }
  .closing-cta h2 { font: 500 clamp(32px, 3.4vw, 40px)/1.15 "Playfair Display", serif; letter-spacing: -0.035em; margin-bottom: 22px; }
  .closing-cta p { max-width: 610px; margin: 0 auto 30px; color: rgba(255, 255, 255, 0.72); line-height: 1.6; font-size: 20px; }
  .closing-cta > small { display: block; color: rgba(255, 255, 255, 0.6); margin-top: 22px; font-size: 14px; }

  /* ---- Motion: hero load fade-up + gated row reveal ---- */
  @media (prefers-reduced-motion: no-preference) {
    .services-hero > * { opacity: 0; animation: svc-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .services-hero h1 { animation-delay: 0.06s; }
    .services-hero .lead { animation-delay: 0.12s; }
  }
  @keyframes svc-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  /* Reveal enhances an already-visible default: rows are hidden only once JS adds
     .reveal; no-JS / reduced-motion / headless keep them fully visible. */
  :global(.reveal) .stagger > * {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .stagger.in > * { opacity: 1; transform: none; }
  :global(.reveal) .stagger.in > *:nth-child(2) { transition-delay: 0.08s; }
  :global(.reveal) .stagger.in > *:nth-child(3) { transition-delay: 0.16s; }

  /* ---- Responsive ---- */
  @media (max-width: 800px) {
    .services-hero .lead { font-size: 16px; }
    .svc-row { gap: 18px; padding-top: 24px; padding-bottom: 24px; }
    .closing-cta { min-height: 470px; padding: 100px 22px; }
    .closing-cta p { font-size: 16px; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduce.matches) {
    document.documentElement.classList.add("reveal");
    const els = document.querySelectorAll(".stagger");
    const show = (el) => el.classList.add("in");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { show(entry.target); io.unobserve(entry.target); }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden if the observer can't fire
      // (background tab, headless renderer, throttled JS). Reveal all after a beat.
      setTimeout(() => els.forEach(show), 1500);
    } else {
      els.forEach(show);
    }
  }
</script>
