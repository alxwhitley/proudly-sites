---
/*
  Services index (/services) - Persuade surface, established-world extension of the
  homepage's "Grounded Workshop." Reshaped from the identical 3-card grid into a
  thesis-led EDITORIAL INDEX (Impeccable shape brief, 2026-08-07): a dominant Fraunces
  thesis carries the one-person message, then the three services are hairline-divided
  full-width rows (name + one-line outcome + terracotta arrow), each whole row a link
  to its detail page. No cards, no glyph chips, no per-section eyebrow, no numbering.
  Identity locked: tokens, Fraunces/Lato, the one terracotta accent, and the dark
  closing CTA are inherited unchanged from the shared system.
  See .impeccable/surfaces/src-pages-services.md for the cluster brief.
*/
import BaseLayout from "../../layouts/BaseLayout.astro";
import smithCashImage from "../../assets/case-studies/smith-cash-family-law/hero.jpeg";
import legacyImage from "../../assets/case-studies/legacy-renovations/hero.jpeg";
import { services } from "../../data/services";

// Claim blocks (Layout Discipline: Paired Claim Rule) - one per service, alternating
// sides, each paired with a real screenshot where one exists. Descriptions reuse real
// sentences already approved on each service's own detail page (hero lead + a bridge
// line) rather than inventing new copy. Search & AI Visibility has no live client
// precedent yet (PRODUCT.md), so its claim block runs on a logged placeholder -
// see REPLACE.md.
const claims = [
  {
    title: "Branding",
    href: "/services/branding",
    heading: "A brand people trust before you say a word",
    description: "Color, type, and voice built around how your clients actually decide, so the right person feels they are in good hands the moment they land. The brand you approve is the brand that reaches your clients, because nothing gets handed to another team to reinterpret.",
    cta: "See the branding work",
    image: smithCashImage.src,
    imageAlt: "The Smith Cash Family Law website, brand carried through calm, trustworthy design",
  },
  {
    title: "Web Design",
    href: "/services/web-design",
    heading: "Design that makes the right people stop and stay",
    description: "Every page built around your client’s problem and how you solve it, so the person who was already told to call you arrives and thinks, yes, this is the one. You get design, brand, and build from the same person, so the page that stops people is never fighting a build it can’t rely on.",
    cta: "See the web design work",
    image: legacyImage.src,
    imageAlt: "The Legacy Renovations website, leading with finished work",
  },
  {
    title: "Search & AI Visibility",
    href: "/services/ai-and-search-visibility",
    heading: "Built to be found when someone searches for you",
    description: "Your pages are built to be ranked by Google and quoted by the AI assistants buyers now ask first, so you can show up in the answer, not three clicks past it. It is about a site that is fast, cleanly structured, and clear about who you are, so a search engine and an AI can both read it, trust it, and hand you to the person looking.",
    cta: "See Search & AI Visibility",
    image: null,
    phLabel: "AI Overview citation capture pending",
  },
];
---

<BaseLayout
  title="Services · Proudly Sites"
  description="Branding, web design, and search & AI visibility for reputation-led service businesses, handled in-house by one person in Raleigh, North Carolina."
>
  <section class="section services-hero">
    <!--
      THESIS: three services are three parts of one job carried by one person; refuse the interchangeable "à la carte tiles" card grid.
      OWN-WORLD: the homepage's Grounded Workshop, inherited whole - Warm Cream ground, Espresso Black close, Fraunces headings on Lato text, one Burnt Terracotta accent, one stacked-shadow CTA.
      STORY: a founder weighing what they need reads one confident statement, scans three plainly-named parts of one job, then opens the part that fits or takes the ask.
      FORM: editorial index (masthead thesis + hairline-ruled service rows), established-world extension, no concept roll.
    -->
    <h1>One person. Your brand, your<br />site, and how you&rsquo;re found.</h1>
    <p class="lead">Brand, site design, and how you&rsquo;re found, handled by one person, so the pieces fit and nothing gets handed off to be reinterpreted.</p>
  </section>

  <section class="section svc-index-wrap">
    <ul class="svc-index stagger">
      {services.map((s) => (
        <li>
          <a class="svc-row" href={s.href}>
            <span class="svc-row-main">
              <span class="svc-name">{s.title}</span>
              <span class="svc-outcome">{s.outcome}</span>
            </span>
            <span class="svc-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section claims-wrap">
    <div class="claims stagger">
      {claims.map((c, i) => (
        <article class:list={["claim-row", { reverse: i % 2 === 1 }]}>
          <div class="claim-visual">
            {c.image
              ? <img src={c.image} alt={c.imageAlt} loading="lazy" width="720" height="480" />
              : <div class="ph-panel" data-placeholder="true" role="img" aria-label={`${c.title} - ${c.phLabel}`}><span>{c.title}</span><small>{c.phLabel}</small></div>}
          </div>
          <div class="claim-copy">
            <h2>{c.heading}</h2>
            <p>{c.description}</p>
            <a class="claim-link" href={c.href}>{c.cta} &rarr;</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="closing-cta">
    <h2>Your Work Deserves a Website That<br />Proves It</h2>
    <p>Send a message about your business. You&rsquo;ll hear back from me, not a sales team, within a day, with honest advice on whether a new site is even the right move.</p>
    <a class="primary-button" href="/contact">Get in Touch</a>
    <small>Live in weeks, not months.</small>
  </section>
</BaseLayout>

<style>
  /* Route-specific composition (editorial index). Tokens + chrome are global; the
     world is inherited from the homepage and the service-detail template. */

  /* ---- Hero: thesis is the dominant element, no eyebrow ---- */
  .section.services-hero {
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: clamp(28px, 3.5vw, 48px);
  }
  .services-hero h1 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0 0 24px;
    max-width: 20ch;
  }
  .services-hero .lead {
    font-size: 20px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--muted);
    margin: 0;
    max-width: 40rem;
  }

  /* ---- Editorial service rows (hairline-ruled, whole row is the link) ---- */
  .section.svc-index-wrap {
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(72px, 9vw, 140px);
  }
  .svc-index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .svc-index li { border-bottom: 1px solid var(--line); }
  .svc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(20px, 4vw, 64px);
    padding: clamp(28px, 3.4vw, 44px) 8px clamp(28px, 3.4vw, 44px) 0;
    transition: background-color 0.3s ease;
  }
  .svc-row:hover,
  .svc-row:focus-visible {
    background-color: rgba(26, 15, 10, 0.025);
  }
  .svc-row-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .svc-row:hover .svc-row-main,
  .svc-row:focus-visible .svc-row-main { transform: translateX(8px); }
  .svc-name {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(24px, 2.9vw, 32px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--espresso);
  }
  .svc-outcome {
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--muted);
    max-width: 46ch;
  }
  .svc-arrow {
    flex: none;
    color: var(--espresso);
    font-size: 24px;
    line-height: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .svc-arrow { transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .svc-row:hover .svc-arrow,
    .svc-row:focus-visible .svc-arrow { transform: translateX(7px); }
  }

  /* ---- Claim blocks (Layout Discipline: Paired Claim + Alternating Fold) ---- */
  .section.claims-wrap {
    padding-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(88px, 10vw, 150px);
  }
  .claims { display: flex; flex-direction: column; gap: clamp(64px, 8vw, 120px); }
  .claim-row {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 4.5vw, 70px);
    align-items: center;
  }
  .claim-row.reverse .claim-visual { order: 2; }
  .claim-visual {
    background: var(--sand);
    border-radius: 16px;
    padding: clamp(20px, 2.4vw, 32px);
  }
  .claim-visual img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
  }
  .claim-visual .ph-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    aspect-ratio: 4 / 3;
    background: var(--oat);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-align: center;
    padding: 24px;
  }
  .claim-visual .ph-panel span {
    font-family: "Fraunces", Georgia, serif;
    font-size: 20px;
    color: var(--espresso);
  }
  .claim-visual .ph-panel small {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #655b54;
  }
  .claim-copy h2 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(26px, 2.8vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--espresso);
    margin: 0 0 18px;
    max-width: 18ch;
  }
  .claim-copy p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 24px;
    max-width: 46ch;
  }
  .claim-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--espresso);
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .claim-link { transition: transform 0.2s ease; }
    .claim-link:hover,
    .claim-link:focus-visible { transform: translateX(4px); }
  }

  /* ---- Closing CTA (homepage instance, verbatim) ---- */
  .closing-cta { min-height: 520px; background: var(--espresso); color: #fff; text-align: center; padding: 125px 24px 115px; }
  .closing-cta h2 { font: 500 clamp(32px, 3.4vw, 40px)/1.15 "Fraunces", serif; letter-spacing: -0.035em; margin-bottom: 22px; }
  .closing-cta p { max-width: 610px; margin: 0 auto 30px; color: rgba(255, 255, 255, 0.72); line-height: 1.6; font-size: 20px; }
  .closing-cta > small { display: block; color: rgba(255, 255, 255, 0.6); margin-top: 22px; font-size: 14px; }

  /* ---- Motion: hero load fade-up + gated row reveal ---- */
  @media (prefers-reduced-motion: no-preference) {
    .services-hero > * { opacity: 0; animation: svc-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .services-hero h1 { animation-delay: 0.06s; }
    .services-hero .lead { animation-delay: 0.12s; }
  }
  @keyframes svc-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  /* Reveal enhances an already-visible default: rows are hidden only once JS adds
     .reveal; no-JS / reduced-motion / headless keep them fully visible. */
  :global(.reveal) .stagger > * {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .stagger.in > * { opacity: 1; transform: none; }
  :global(.reveal) .stagger.in > *:nth-child(2) { transition-delay: 0.08s; }
  :global(.reveal) .stagger.in > *:nth-child(3) { transition-delay: 0.16s; }

  /* ---- Responsive ---- */
  @media (max-width: 800px) {
    .services-hero .lead { font-size: 16px; }
    .svc-row { gap: 18px; padding-top: 24px; padding-bottom: 24px; }
    .claim-row { grid-template-columns: 1fr; gap: 22px; }
    .claim-row.reverse .claim-visual { order: 0; }
    .claims { gap: 56px; }
    .closing-cta { min-height: 470px; padding: 100px 22px; }
    .closing-cta p { font-size: 16px; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduce.matches) {
    document.documentElement.classList.add("reveal");
    const els = document.querySelectorAll(".stagger");
    const show = (el) => el.classList.add("in");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { show(entry.target); io.unobserve(entry.target); }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden if the observer can't fire
      // (background tab, headless renderer, throttled JS). Reveal all after a beat.
      setTimeout(() => els.forEach(show), 1500);
    } else {
      els.forEach(show);
    }
  }
</script>
