---
/*
  Services / Web Design (/services/web-design) - Persuade surface, established-world
  extension of the homepage's "Grounded Workshop." No new world, no concept roll.
  Picture-forward proof page (services-copy.md pattern) rebuilt on the live shared
  system (BaseLayout / global.css tokens + chrome). Structure: hero (outcome H1),
  real client proof rows (alternating image + decision caption), a two-card
  "Bigger Picture" bridge to the other two services, and the homepage closing CTA
  reused verbatim. This file is the service-detail template; web-design and
  ai-and-search-visibility clone its structure with their own copy.
  See .impeccable/surfaces/src-pages-services.md for the cluster brief.
*/
import BaseLayout from "../../layouts/BaseLayout.astro";
import smithCashImage from "../../assets/case-studies/smith-cash-family-law/hero.jpeg";
import legacyImage from "../../assets/case-studies/legacy-renovations/hero.jpeg";
import afterHoursImage from "../../assets/case-studies/after-hours-ministry/work-index.jpeg";

// Real client proof using approved local case-study captures.
const proof = [
  {
    client: "Smith Cash Family Law",
    image: smithCashImage.src,
    imageAlt: "The Smith Cash Family Law website, honest and steady in the first seconds",
    caption:
      "Anxious clients decide in seconds whether a firm feels safe. The design makes this firm feel honest and steady before the first phone call.",
  },
  {
    client: "Legacy Renovations",
    image: legacyImage.src,
    imageAlt: "The Legacy Renovations site leading with a finished kitchen remodel",
    caption:
      "Homeowners hire the remodeler they trust with their house. The design leads with finished work and makes requesting a quote feel like the obvious next step.",
  },
  {
    client: "After Hours Ministry",
    image: afterHoursImage.src,
    imageAlt: "After Hours Ministry website shown in a desktop browser frame",
    caption:
      "A ministry site has to feel personal, not corporate. The design carries the founder’s voice on the page the same way it reads in person.",
  },
];

// The other two services, for the Bigger Picture bridge (one-person differentiator).
const siblings = [
  { title: "Branding", href: "/services/branding", teaser: "Identity, voice, and the brand your design expresses." },
  { title: "Search & AI Visibility", href: "/services/ai-and-search-visibility", teaser: "Built to be found and quoted when buyers search Google and ask AI." },
];
---

<BaseLayout
  title="Web Design · Proudly Sites"
  description="Web design for reputation-led service businesses: every page built around your client's problem and how you solve it, proven with real client work."
>
  <section class="section svc-hero">
    <!--
      THESIS: prove the design claim with real client work, refuse the deliverable-list "what's included" template.
      OWN-WORLD: the homepage's Grounded Workshop, inherited whole - Warm Cream ground, Espresso Black close, Fraunces headings on Lato text, Honey Gold decorating only, one Burnt Terracotta stacked-shadow CTA.
      STORY: a referred founder who cares most about the design sees three real sites in context, understands one person carries design through brand and build, then takes the ask.
      FIRST VIEWPORT: eyebrow, outcome H1, one-line lead; the primary action waits at the close.
      FORM: established-world extension (no concept roll); service-detail template for the cluster.
    -->
    <h1>Design That Makes the Right People Stop and Stay</h1>
    <p class="lead">Every page built around your client&rsquo;s problem and how you solve it, so the person who was already told to call you arrives and thinks, yes, this is the one.</p>
  </section>

  <div class="surface-white">
    <section class="section proof">
      <h2 class="proof-heading rv">Real client work</h2>
      <div class="proof-rows">
        {proof.map((item, i) => (
          <article class:list={["proof-row", "rv", { reverse: i % 2 === 1 }]}>
            <div class="proof-visual">
              {item.image
                ? <img src={item.image} alt={item.imageAlt} loading="lazy" width="720" height="540" />
                : <div class="ph-panel" data-placeholder="true" role="img" aria-label={`${item.client} - live-site capture pending`}><span>{item.client}</span><small>Live-site capture pending</small></div>}
            </div>
            <div class="proof-copy">
              <p class="proof-client">{item.client}</p>
              <p class="proof-caption">{item.caption}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <section class="section bridge rv">
    <h2>Design is the part your clients see, not the whole job</h2>
    <p class="bridge-body">A page that stops the right person only works if the brand underneath it already earned trust and the build behind it holds up on their phone. You get all three from the same person, so the design is never fighting a brand it did not choose or a build it cannot rely on.</p>
    <div class="bridge-cards">
      {siblings.map((s) => (
        <a class="bridge-card" href={s.href}>
          <span class="bridge-arrow" aria-hidden="true">&#8599;</span>
          <h3>{s.title}</h3>
          <p>{s.teaser}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="closing-cta">
    <h2>Your Work Deserves a Website That<br />Proves It</h2>
    <p>Send a message about your business. You&rsquo;ll hear back from me, not a sales team, within a day, with honest advice on whether a new site is even the right move.</p>
    <a class="primary-button" href="/contact">Get in Touch</a>
    <small>Live in weeks, not months.</small>
  </section>
</BaseLayout>

<style>
  /* Route-specific composition for the service-detail template. Tokens + chrome
     are global; this world is inherited from /about and the homepage. */

  .surface-white { background: var(--white); }

  /* ---- Hero ---- */
  .section.svc-hero {
    max-width: 900px;
    padding-top: clamp(56px, 7vw, 104px);
    padding-bottom: clamp(48px, 5vw, 84px);
  }
  .svc-hero h1 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 4.6vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0 0 22px;
    max-width: 16ch;
  }
  .svc-hero .lead {
    font-size: 20px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--muted);
    margin: 0;
    max-width: 40rem;
  }

  /* ---- Proof rows (alternating image + decision caption) ---- */
  .proof-heading {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(26px, 2.8vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--espresso);
    margin: 0 0 48px;
  }
  .proof-rows { display: flex; flex-direction: column; gap: clamp(48px, 6vw, 88px); }
  .proof-row {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(32px, 4.5vw, 70px);
    align-items: center;
  }
  .proof-row.reverse .proof-visual { order: 2; }
  .proof-visual {
    border-radius: 16px;
    overflow: hidden;
  }
  .proof-visual img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
  }
  .ph-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    aspect-ratio: 4 / 3;
    background: var(--oat);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-align: center;
    padding: 24px;
  }
  .ph-panel span {
    font-family: "Fraunces", Georgia, serif;
    font-size: 20px;
    color: var(--espresso);
  }
  .ph-panel small {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #655b54;
  }
  .proof-client {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6d635c;
    margin: 0 0 14px;
  }
  .proof-caption {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--espresso);
    margin: 0;
    max-width: 32ch;
  }

  /* ---- Bigger Picture bridge ---- */
  .section.bridge { max-width: 1000px; }
  .bridge h2 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 3.6vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    margin: 0 0 22px;
    max-width: 20ch;
  }
  .bridge-body {
    font-size: 20px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--muted);
    margin: 0 0 48px;
    max-width: 40rem;
  }
  .bridge-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .bridge-card {
    position: relative;
    display: block;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 30px 30px 34px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .bridge-card:hover { transform: translateY(-2px); border-color: var(--clay); }
  .bridge-arrow {
    position: absolute;
    top: 26px;
    right: 28px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--terracotta);
    font-size: 16px;
  }
  .bridge-card h3 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 18px 0 10px;
  }
  .bridge-card p { font-size: 16px; line-height: 1.55; color: var(--muted); margin: 0; max-width: 30ch; }

  /* ---- Closing CTA (homepage instance, verbatim) ---- */
  .closing-cta { min-height: 520px; background: var(--espresso); color: #fff; text-align: center; padding: 125px 24px 115px; }
  .closing-cta h2 { font: 500 clamp(32px, 3.4vw, 40px)/1.15 "Fraunces", serif; letter-spacing: -0.035em; margin-bottom: 22px; }
  .closing-cta p { max-width: 610px; margin: 0 auto 30px; color: rgba(255, 255, 255, 0.72); line-height: 1.6; font-size: 20px; }
  .closing-cta > small { display: block; color: rgba(255, 255, 255, 0.6); margin-top: 22px; font-size: 14px; }

  /* ---- Motion: hero load fade-up + gated scroll reveal ---- */
  @media (prefers-reduced-motion: no-preference) {
    .svc-hero > * { opacity: 0; animation: svc-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .svc-hero h1 { animation-delay: 0.06s; }
    .svc-hero .lead { animation-delay: 0.12s; }
  }
  @keyframes svc-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  :global(.reveal) .rv {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .rv.in { opacity: 1; transform: none; }

  /* ---- Responsive ---- */
  @media (max-width: 800px) {
    .proof-row { grid-template-columns: 1fr; gap: 22px; }
    .proof-row.reverse .proof-visual { order: 0; }
    .proof-caption { font-size: 20px; }
    .svc-hero .lead, .bridge-body { font-size: 16px; }
    .bridge-cards { grid-template-columns: 1fr; }
    .closing-cta { min-height: 470px; padding: 100px 22px; }
    .closing-cta p { font-size: 16px; }
  }

  @media (min-width: 801px) {
    .closing-cta { min-height: 520px; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduce.matches) {
    document.documentElement.classList.add("reveal");
    const els = document.querySelectorAll(".rv, .stagger");
    const show = (el) => el.classList.add("in");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { show(entry.target); io.unobserve(entry.target); }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden if the observer can't fire
      // (background tab, headless renderer, throttled JS). Reveal all after a beat.
      setTimeout(() => els.forEach(show), 1500);
    } else {
      els.forEach(show);
    }
  }
</script>
