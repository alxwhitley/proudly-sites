---
/*
  Unlisted field-visit spreadsheet (/clients). Dense dark grid for the
  27613 loops. Leads live in src/data/field-visits.json. Not in marketing nav.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  fieldVisits,
  industryGroup,
  mapsSearchUrl,
  telHref,
  websiteLabel,
} from "../data/field-visits";

const { home, sets } = fieldVisits;
const homeMaps = mapsSearchUrl(home.address);

const rows = sets.flatMap((set, setIndex) =>
  set.stops.map((stop, stopIndex) => ({
    set,
    setNumber: setIndex + 1,
    stopNumber: stopIndex + 1,
    firstInSet: stopIndex === 0,
    group: industryGroup(stop.industry),
    stop,
  }))
);

const rowCount = rows.length;
---

<BaseLayout
  title="27613 field visits · Proudly Sites"
  description="Unlisted 27613 field-visit list for Proudly Sites."
  noindex
  chrome={false}
  bodyClass="sheet-page"
>
  <div class="sheet">
    <header class="sheet-bar">
      <div class="sheet-title-row">
        <h1>27613 field visits</h1>
        <p class="row-count"><span data-row-count>{rowCount}</span> rows</p>
      </div>
      <p class="sheet-home">
        Home:
        <a href={homeMaps} target="_blank" rel="noopener noreferrer">{home.address}</a>
      </p>
      <nav class="sheet-tabs" aria-label="Industry filters">
        <button type="button" class="is-selected" data-filter="all" aria-pressed="true">All leads</button>
        <button type="button" data-filter="church" aria-pressed="false">Churches</button>
        <button type="button" data-filter="healthcare" aria-pressed="false">Healthcare</button>
        <button type="button" data-filter="law" aria-pressed="false">Law firms</button>
      </nav>
    </header>

    <div class="sheet-scroll">
      <table class="lead-table">
        <thead>
          <tr>
            <th scope="col">Set</th>
            <th scope="col">Stop</th>
            <th scope="col">Sent</th>
            <th scope="col">Name</th>
            <th scope="col">Industry</th>
            <th scope="col">Address</th>
            <th scope="col">Hours</th>
            <th scope="col">Closed</th>
            <th scope="col">Phone</th>
            <th scope="col">Website</th>
            <th scope="col">Note</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ set, setNumber, stopNumber, firstInSet, group, stop }) => (
            <tr
              data-group={group || undefined}
              data-set={set.id}
              class:list={[{ "is-extra": stop.extra, "is-set-start": firstInSet, "is-sent": stop.emailed }]}
            >
              <td class="col-set">
                <span class="set-num">{setNumber}</span>
                {firstInSet && (
                  <a class="loop-maps" href={set.mapsUrl} target="_blank" rel="noopener noreferrer">
                    Open this loop in Maps
                  </a>
                )}
              </td>
              <td class="col-stop">{stopNumber}</td>
              <td class="col-sent">
                <input
                  type="checkbox"
                  disabled
                  checked={stop.emailed === true}
                  aria-label={`Sent: ${stop.name}`}
                />
              </td>
              <td class="col-name">{stop.name}</td>
              <td class="col-industry">{stop.industry ?? ""}</td>
              <td class="col-address">
                {stop.address && (
                  <a href={mapsSearchUrl(stop.address)} target="_blank" rel="noopener noreferrer">
                    {stop.address}
                  </a>
                )}
              </td>
              <td class="col-hours">{stop.hours ?? ""}</td>
              <td class="col-closed">{stop.typicallyClosed ?? ""}</td>
              <td class="col-phone">
                {stop.phone && <a href={telHref(stop.phone)}>{stop.phone}</a>}
              </td>
              <td class="col-site">
                {stop.website && (
                  <a href={stop.website} target="_blank" rel="noopener noreferrer">{websiteLabel(stop.website)}</a>
                )}
              </td>
              <td class="col-note">
                {stop.note ?? ""}
                {stop.email && (
                  <>
                    {stop.note ? " " : ""}
                    <a href={`mailto:${stop.email}`}>{stop.email}</a>
                  </>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const rows = document.querySelectorAll<HTMLTableRowElement>("tbody tr");
  const countEl = document.querySelector("[data-row-count]");

  const applyFilter = (filter: string) => {
    let visible = 0;
    rows.forEach((row) => {
      const group = row.dataset.group ?? "";
      const show = filter === "all" || group === filter;
      row.hidden = !show;
      if (show) visible += 1;
    });
    if (countEl) countEl.textContent = String(visible);
    tabs.forEach((tab) => {
      const on = tab.dataset.filter === filter;
      tab.classList.toggle("is-selected", on);
      tab.setAttribute("aria-pressed", String(on));
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => applyFilter(tab.dataset.filter ?? "all"));
  });
</script>

<style is:global>
  body.sheet-page {
    background: #111;
    color: #f2f2f2;
    font-family: "Lato", -apple-system, sans-serif;
    font-size: 13px;
    line-height: 1.25;
  }
  body.sheet-page main {
    display: block;
  }
</style>

<style>
  .sheet {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: #111;
    color: #f2f2f2;
  }

  .sheet-bar {
    position: sticky;
    top: 0;
    z-index: 6;
    background: #111;
    border-bottom: 1px solid #2c2c2c;
    padding: 10px 12px 8px;
  }
  .sheet-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .sheet-title-row h1 {
    font-family: "Lato", -apple-system, sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.02em;
    margin: 0;
    color: #fff;
  }
  .row-count {
    margin: 0;
    color: #a3a3a3;
    font-size: 12px;
    white-space: nowrap;
  }
  .sheet-home {
    margin: 4px 0 8px;
    color: #a3a3a3;
    font-size: 12px;
  }
  .sheet-home a {
    color: #e8e8e8;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .sheet-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .sheet-tabs button {
    appearance: none;
    border: 0;
    background: transparent;
    color: #c4c4c4;
    font: inherit;
    font-size: 12px;
    line-height: 1;
    padding: 7px 10px;
    border-radius: 999px;
    min-height: 32px;
    cursor: pointer;
  }
  .sheet-tabs button.is-selected {
    background: #2a2a2a;
    color: #fff;
  }
  .sheet-tabs button:focus-visible {
    outline: 2px solid #f3c045;
    outline-offset: 2px;
  }

  .sheet-scroll {
    flex: 1;
    overflow: auto;
  }

  .lead-table {
    width: max-content;
    border-collapse: collapse;
    table-layout: auto;
  }
  .lead-table th,
  .lead-table td {
    border: 1px solid #2c2c2c;
    padding: 5px 8px;
    vertical-align: top;
    text-align: left;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1.3;
  }
  .lead-table th {
    position: sticky;
    top: 0;
    z-index: 4;
    background: #1a1a1a;
    color: #d0d0d0;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.02em;
  }
  .lead-table td {
    background: #111;
    color: #f2f2f2;
  }
  .lead-table tbody tr:nth-child(even) td {
    background: #161616;
  }
  .lead-table tbody tr.is-set-start td {
    border-top-color: #3a3a3a;
  }
  .lead-table tbody tr.is-extra td {
    background: #1b1b1b;
  }
  .lead-table tbody tr.is-sent td {
    color: #8d8d8d;
  }
  .lead-table tbody tr.is-sent a {
    color: #9a9a9a;
  }
  .col-sent {
    text-align: center;
    width: 2.5rem;
  }
  .col-sent input {
    margin: 0;
    accent-color: #cfcfcf;
    pointer-events: none;
  }
  .lead-table a {
    color: #e8e8e8;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .lead-table a:focus-visible {
    outline: 2px solid #f3c045;
    outline-offset: 2px;
  }

  .col-set {
    min-width: 7.5rem;
    max-width: 9.5rem;
    white-space: normal;
  }
  .set-num {
    display: inline-block;
    min-width: 1em;
    color: #cfcfcf;
  }
  .loop-maps {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    color: #d7d7d7;
  }
  .col-stop { font-variant-numeric: tabular-nums; }
  .col-name { font-weight: 700; }
  .col-hours,
  .col-note {
    white-space: normal;
    min-width: 12rem;
    max-width: 22rem;
  }
  .col-address {
    white-space: normal;
    min-width: 14rem;
    max-width: 20rem;
  }
  .col-industry { min-width: 7rem; }
  .col-closed { min-width: 7rem; }
  .col-phone { min-width: 7.5rem; font-variant-numeric: tabular-nums; }
  .col-site { min-width: 10rem; }
</style>
