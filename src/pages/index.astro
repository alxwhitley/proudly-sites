iews-head .gold-dot{display:inline-block;width:6px;height:6px;background:var(--gold);border-radius:50%;margin-right:8px}.section-heading>p{display:inline-block;margin-bottom:18px}.section-heading h2,.reviews-head h2{font:400 40px/1.1 "Lato",sans-serif;letter-spacing:-.035em;margin:0}.projects{border-top:1px solid var(--line)}.project{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;padding:64px 0;border-bottom:1px solid var(--line)}.project.reverse .project-visual{order:2}.project-visual{background:var(--sand);border-radius:16px;padding:30px;min-height:390px;display:flex;align-items:center}.project-visual img{width:100%;aspect-ratio:1.5/1;object-fit:cover;border-radius:10px;box-shadow:0 22px 35px rgba(26,15,10,.14)}.project-copy h3{font:500 34px/1.13 "Playfair Display",serif;letter-spacing:-.04em;margin-bottom:18px}.project-copy>p:not(.project-label){color:var(--muted);max-width:58ch}.tags{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:22px 0;list-style:none}.tags li{background:#f1eee9;border:1px solid #e3ddd7;border-radius:999px;padding:7px 11px;color:#746862;font-size:11px}.project-copy blockquote{border-left:1px solid var(--gold);padding-left:14px;margin:23px 0;font:500 13px/1.5 "Playfair Display",serif}.project-copy cite{display:block;font:400 10px/1.4 "Lato",sans-serif;margin-top:7px;color:#8e8079}.text-link{font-size:12px;font-weight:700}.about{max-width:none;background:#eeece7;padding-left:max(40px,calc((100vw - 1260px)/2));padding-right:max(40px,calc((100vw - 1260px)/2))}.about-inner{max-width:1180px;margin:auto;display:grid;grid-template-columns:.82fr 1.18fr;gap:70px;align-items:center}.about-photo{width:100%;height:550px;object-fit:cover;object-position:center 35%;border-radius:16px}.about-copy .section-heading{margin-bottom:20px}.about-copy h2{font:500 40px/1.1 "Playfair Display",serif;letter-spacing:-.04em;margin-bottom:22px}.about-lead{color:var(--muted);max-width:62ch}.about-points{display:grid;grid-template-columns:1fr 1fr;