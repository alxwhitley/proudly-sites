---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Tags from "../components/Tags.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import smithCashHomepage from "../assets/Homepage/case-study-section-1 copy.png";
import vitalWatchHomepage from "../assets/Homepage/section1 copy.png";
import legacyRenovationsHomepage from "../assets/Homepage/section2-browser copy.png";

const featuredCases = await getCollection("caseStudies", ({ data }) =>
  data.status === "published" && data.featured && Boolean(data.homepage)
);
const featuredBySlug = new Map(featuredCases.map(({ data }) => [data.slug, data]));

const projectFromCase = (slug: string) => {
  const item = featuredBySlug.get(slug);
  if (!item?.homepage || !item.heroImage) throw new Error(`Incomplete featured case study: ${slug}`);
  return {
    name: item.title,
    location: item.location ?? "",
    title: item.headline,
    body: item.homepage.body,
    image: item.heroImage.src,
    imageAlt: item.heroAlt,
    tags: item.homepage.tags,
    quote: item.homepage.quoteExcerpt,
    author: item.homepage.quoteCite,
    href: `/work/${item.slug}`,
  };
};

const projects = [
  { ...projectFromCase("smith-cash-family-law"), image: smithCashHomepage },
  {
    name: "Vital Watch",
    location: "Raleigh",
    title: "A home nursing service that finally looks like the care it gives",
    body: "A Medicare-covered nursing service needed a site that felt clinical and trustworthy, not templated. I built service pages, an FAQ, custom navigation, and a referral system for healthcare partners, all HIPAA-aware from the ground up.",
    image: vitalWatchHomepage,
    imageAlt: "Vital Watch healthcare website shown as a stitched browser-page composition",
    tags: ["Full Brand Launch", "Custom Nav", "Healthcare Partners Portal", "SEO"],
    href: "/work",
    liveUrl: "https://www.vitalwatch24.com/",
  },
  { ...projectFromCase("legacy-renovations"), image: legacyRenovationsHomepage },
];

const process = [
  ["We Talk, Founder to Founder", "Tell me about your business and what’s not working. You’ll hear back from me directly, within a day, with honest advice on whether a new site is even the right move."],
  ["Strategy Before Design", "I map your audience and what your site needs to prove before anything gets built. Your reputation drives the plan, not a template."],
  ["You See Real Pages", "No abstract wireframes. You review the actual site as it comes together, and changes come straight from me."],
  ["Live, and Yours to Run", "Your site launches on your domain with SEO foundations in place, easy to update, and ready to send to every referral."],
];

const testimonials = [
  ["“Alex was so helpful in creating a website for our ministry. For anyone trying to go beyond generic sites, I would highly recommend.”", "Josh F.", "After Hours Ministry"],
  ["“Working with Alex on our law firm website was a great experience from start to finish. Thoughtful, professional, and highly receptive to feedback.”", "Kelly S.", "Smith Cash Law"],
  ["“The design looks amazing, the site runs smoothly, and everything was completed on time.”", "Tony R.", "Legacy Renovations"],
];
---

<BaseLayout
  title="Proudly Sites | Custom Websites in Raleigh, NC"
  description="Custom websites for reputation-led service businesses, designed and built directly by Alex Whitley in Raleigh, North Carolina."
>
  <!--
  THESIS: Reproduce the current Proudly Sites homepage as the trusted artifact; refuse a new agency-template interpretation.
  OWN-WORLD: Warm cream and white fields alternate with espresso sections; Fraunces display, Lato utility, terracotta actions, honey-gold detail, flat hairline cards.
  STORY: A referral-led owner recognizes an outgrown website, sees real work and one accountable founder, understands the process, then makes contact.
  FIRST VIEWPORT: Framed pill nav above a centered serif claim, terracotta italic emphasis, concise support, primary action, founder chip, and proof strip.
  FORM: Exact incumbent Framer homepage recreation, approved existing-design canon, seed b88b9f47.
  ROUTE-SPECIFIC: the centered hero, section order, and narrative below are homepage-only; shared chrome (layout, header, footer, buttons, tags, tokens) is extracted to the design system and NOT a global template.
  -->
  <section class="hero">
    <p class="hero-location">Raleigh, North Carolina</p>
    <h1>Your Business Has <em>Outgrown</em><br />Your Website</h1>
    <p class="hero-copy">Custom websites for businesses that win on reputation. Strategy, copy, and design handled in-house, so your site finally says what your work already proves.</p>
    <div class="hero-actions">
      <Button href="/contact">Get in Touch</Button>
      <a class="phone" href="tel:+19196348169">(919) 634-8169</a>
    </div>
    <div class="founder-chip">
      <img src="/images/alex-whitley.jpeg" alt="Alex Whitley" width="44" height="44" />
      <span><strong>You work directly with me.</strong><small>Alex Whitley, Founder</small></span>
    </div>
  </section>

  <section class="proof-strip" aria-label="Client proof">
    <div class="google-proof">
      <b>G</b><span><strong>5.0 Google Reviews</strong><small>★★★★★</small></span>
    </div>
    <div class="proof-clients">
      <span><b>Smith Cash Family Law</b><small>Family Law</small></span>
      <span><b>After Hours Ministry</b><small>Nonprofit &amp; Church</small></span>
      <span><b>Vital Watch</b><small>Healthcare</small></span>
      <span><b>Legacy Renovations</b><small>Kitchen &amp; Bath</small></span>
    </div>
  </section>

  <section class="work section" id="work">
    <div class="section-heading"><h2>Their Craft, Presented Well</h2></div>
    <div class="projects">
      {projects.map((project, index) => (
        <article class:list={["project", { reverse: index % 2 === 1 }]}>
          <div class="project-visual" data-pointer-tilt>
            <div class="project-visual-inner">
              <Image src={project.image} alt={project.imageAlt} loading="lazy" />
            </div>
          </div>
          <div class="project-copy">
            <p class="project-label">{project.name} · {project.location}</p>
            <h3>{project.title}</h3>
            <p>{project.body}</p>
            <Tags tags={project.tags} />
            {project.quote && <blockquote>{project.quote}<cite>{project.author}</cite></blockquote>}
            {project.href.startsWith("/work/")
              ? <a class="text-link" href={project.href}>View Project →</a>
              : project.liveUrl
                ? <button type="button" class="text-link js-live-site" data-live-url={project.liveUrl}>See Live Site</button>
                : <span class="text-link is-pending" aria-disabled="true" title="Live site pending">See Live Site</span>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="about section" id="about">
    <div class="about-inner">
      <img class="about-photo" src="/images/alex-whitley.jpeg" alt="Alex Whitley in his Raleigh studio" loading="lazy" />
      <div class="about-copy">
        <h2>Hi, I’m Alex. Your project never gets handed off.</h2>
        <p class="about-lead">Proudly Sites is a one-person studio in Raleigh. When you work with me, the person on the discovery call is the same person writing your copy, designing your pages, and answering your emails. No account managers, no junior designers, no telephone game.</p>
        <div class="about-points">
          <div><b>Direct, every step</b><span>One point of contact from first call to launch.</span></div>
          <div><b>Weeks, not months</b><span>A clear process that respects your time.</span></div>
          <div><b>Clear pricing, agreed upfront</b><span>No surprise invoices, ever.</span></div>
          <div><b>Raleigh-based</b><span>Local, reachable, invested in Triangle businesses.</span></div>
        </div>
        <Button href="/contact" class="about-cta">Get in Touch</Button>
      </div>
    </div>
  </section>

  <section class="services section" id="services">
    <div class="section-heading centered"><h2>Strategy, Copy, and Design, In-House</h2></div>
    <div class="service-grid">
      <article><span class="service-icon">◎</span><h3>Branding</h3><p>A brand that earns trust before you say a word. Color, type, and voice built around how your clients actually decide.</p></article>
      <article><span class="service-icon">▣</span><h3>Web Design</h3><p>Design that makes the right people stop and stay. Every section built around your client’s problem and how you solve it, not a template.</p></article>
      <article><span class="service-icon">⌁</span><h3>Search &amp; AI Visibility</h3><p>Get found the moment someone searches, on Google and the AI assistants buyers now ask first. Your pages are built to be ranked and quoted, so you show up in the answer, not three clicks past it.</p></article>
    </div>
  </section>

  <section class="process-section" id="process">
    <div class="section process-inner">
      <div class="process-intro"><h2>How It Works</h2><span>No mystery, no months of waiting. A clear four-step path from first message to launch.</span></div>
      <div class="process-grid">
        {process.map((step, index) => <article><b>{index + 1}</b><h3>{step[0]}</h3><p>{step[1]}</p></article>)}
      </div>
    </div>
  </section>

  <section class="reviews section">
    <div class="reviews-head"><div><h2>What Clients Say</h2></div></div>
    <div class="review-grid">
      {testimonials.map(item => <blockquote><span>★★★★★</span><p>{item[0]}</p><cite><b>{item[1]}</b>{item[2]}</cite></blockquote>)}
    </div>
  </section>

  <section class="closing-cta">
    <h2>Your Work Deserves a Website That<br />Proves It</h2>
    <p>Send a message about your business. You’ll hear back from me, not a sales team, within a day, with honest advice on whether a new site is even the right move.</p>
    <Button href="/contact">Get in Touch</Button>
    <small>Live in weeks, not months.</small>
  </section>
</BaseLayout>

<style is:global>
  /* Route-specific homepage composition. Shared foundations (tokens, base
     type, header, footer, buttons, tags, .section container) live in
     src/styles/global.css. Nothing below is promoted to a global template. */
  .hero{min-height:670px;padding:84px 24px 72px;display:flex;flex-direction:column;align-items:center;text-align:center;position:relative;overflow:hidden}
  .hero-location,.project-label{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#6d635c;margin-bottom:24px}
  .hero h1{font:500 clamp(48px,5.4vw,78px)/.98 "Fraunces",serif;letter-spacing:-.04em;max-width:920px;margin-bottom:28px}
  .hero h1 em{color:var(--terracotta);font-weight:500}
  .hero-copy{max-width:650px;color:var(--muted);font-size:20px;line-height:1.6;margin-bottom:32px}
  .hero-actions{display:flex;align-items:center;gap:26px}
  .phone{font-size:15px;font-weight:700}
  .founder-chip{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid #ebe7e2;border-radius:999px;padding:6px 20px 6px 7px;margin-top:38px;text-align:left}
  .founder-chip img{width:40px;height:40px;border-radius:50%;object-fit:cover;object-position:56% 43%}
  .founder-chip strong,.founder-chip small{display:block}
  .founder-chip strong{font-size:14px}
  .founder-chip small{font-size:12px;color:#6d635c;margin-top:1px}
  .proof-strip{min-height:120px;background:#eeece7;padding:28px max(40px,calc((100vw - 1240px)/2));display:flex;align-items:center;justify-content:space-between;border-top:1px solid #ece8e3}
  .google-proof{display:flex;align-items:center;gap:12px}
  .google-proof>b{font:bold 28px Arial;color:#222}
  .google-proof span>*{display:block}
  .google-proof strong{font-size:14px}
  .google-proof small{font-size:12px;color:var(--gold)}
  .proof-clients{display:flex;gap:44px}
  .proof-clients span>*{display:block}
  .proof-clients b{font-size:14px}
  .proof-clients small{font-size:12px;color:#6d635c;margin-top:2px}
  .section-heading{margin-bottom:54px}
  .section-heading h2,.reviews-head h2{font:400 40px/1.1 "Lato",sans-serif;letter-spacing:-.035em;margin:0}
  .projects{border-top:1px solid var(--line)}
  .project{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;padding:64px 0;border-bottom:1px solid var(--line)}
  .project.reverse .project-visual{order:2}
  .project-visual[data-pointer-tilt]{perspective:900px}
  .project-visual[data-pointer-tilt] .project-visual-inner{transform-style:preserve-3d;transform:translate3d(var(--pointer-x,0px),var(--pointer-y,0px),0) rotateX(var(--pointer-rx,0deg)) rotateY(var(--pointer-ry,0deg));transition:transform 180ms cubic-bezier(.16,1,.3,1)}
  .project-visual[data-pointer-tilt].is-pointer-active .project-visual-inner{will-change:transform;transition-duration:70ms}
  .project-visual img{display:block;width:100%;height:auto}
  .project-copy h3{font:500 32px/1.13 "Fraunces",serif;letter-spacing:-.04em;margin-bottom:18px}
  .project-copy>p:not(.project-label){color:var(--muted);max-width:58ch}
  .project-copy blockquote{border-left:1px solid var(--gold);padding-left:14px;margin:23px 0;font:500 16px/1.5 "Fraunces",serif}
  .project-copy cite{display:block;font:400 12px/1.4 "Lato",sans-serif;margin-top:7px;color:#6d635c}
  .text-link{font-size:14px;font-weight:700;display:inline-block;background:none;border:0;padding:0;font-family:inherit;cursor:pointer;color:inherit}
  .text-link.is-pending{opacity:.5;cursor:default}
  @media(prefers-reduced-motion:no-preference){.text-link{transition:transform .2s ease}.text-link:hover,.text-link:focus-visible{transform:translateX(4px)}}
  .about.section{max-width:none;background:#eeece7;padding-left:max(40px,calc((100vw - 1260px)/2));padding-right:max(40px,calc((100vw - 1260px)/2))}
  .about-inner{max-width:1180px;margin:auto;display:grid;grid-template-columns:.82fr 1.18fr;gap:70px;align-items:center}
  .about-photo{width:100%;height:550px;object-fit:cover;object-position:center 35%;border-radius:16px}
  .about-copy h2{font:500 40px/1.1 "Fraunces",serif;letter-spacing:-.04em;margin-bottom:22px}
  .about-lead{color:var(--muted);max-width:62ch;font-size:20px;line-height:1.6}
  .about-points{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:28px}
  .about-points div{background:#fff;border:1px solid #e4dfda;border-radius:9px;padding:22px}
  .about-points b,.about-points span{display:block}
  .about-points b{font-size:14px;margin-bottom:6px}
  .about-points span{font-size:14px;color:#6d635c}
  .about-cta{margin-top:34px}
  .centered{text-align:center}
  .service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .service-grid article{background:#fff;border:1px solid var(--line);border-radius:14px;padding:34px 30px 38px}
  .service-icon{width:38px;height:38px;display:grid;place-items:center;background:#fff0e9;color:var(--terracotta);border-radius:8px;margin-bottom:42px;font-size:20px}
  .service-grid h3{font:500 28px/1.2 "Fraunces",serif;letter-spacing:-.035em;margin-bottom:15px}
  .service-grid p{color:var(--muted);font-size:16px}
  .process-section{background:var(--espresso);color:#fff}
  .process-inner{max-width:1340px}
  .process-intro h2{font:500 40px/1.1 "Fraunces",serif;letter-spacing:-.035em;margin-bottom:14px}
  .process-intro span{color:rgba(255,255,255,.72);font-size:20px;line-height:1.6}
  .process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:55px}
  .process-grid article{background:var(--dark-card);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:28px 25px 32px;min-height:290px}
  .process-grid b{color:var(--gold);font:500 32px/1 "Fraunces",serif}
  .process-grid h3{font:500 20px/1.25 "Fraunces",serif;margin:42px 0 15px}
  .process-grid p{font-size:16px;line-height:1.55;color:rgba(255,255,255,.7);margin-bottom:0}
  .reviews-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:50px}
  .reviews-head a{font-size:14px;color:var(--terracotta);font-weight:700}
  .review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .review-grid blockquote,.rating{margin:0;border:1px solid var(--line);border-radius:12px;background:#fff;min-height:245px;padding:34px}
  .review-grid blockquote>span,.rating>span{color:var(--gold);letter-spacing:.1em;font-size:12px}
  .review-grid blockquote p{font:500 20px/1.4 "Fraunces",serif;margin:20px 0 27px}
  .review-grid cite{font-style:normal;font-size:12px;color:#6d635c}
  .review-grid cite b{display:block;color:var(--espresso);font-size:14px}
  .rating{background:#efede9;display:flex;flex-direction:column;align-items:center;justify-content:center}
  .rating strong{font:500 45px/1 "Fraunces",serif}
  .rating small{font-size:12px;color:#6d635c;margin-top:8px}
  .closing-cta{min-height:520px;background:var(--espresso);color:#fff;text-align:center;padding:125px 24px 115px;position:relative;overflow:hidden}
  .closing-cta h2{font:500 40px/1.15 "Fraunces",serif;letter-spacing:-.035em;margin-bottom:22px;position:relative}
  .closing-cta p{max-width:610px;margin:0 auto 30px;color:rgba(255,255,255,.72);line-height:1.6;font-size:20px;position:relative}
  .closing-cta .primary-button{position:relative}
  .closing-cta>small{display:block;color:rgba(255,255,255,.6);margin-top:22px;font-size:14px;position:relative}

  @media(max-width:800px){
    .hero{min-height:520px;padding:55px 20px 45px}
    .hero-location{font-size:12px;margin-bottom:18px}
    .hero h1{font-size:39px;line-height:.98;margin-bottom:20px}
    .hero-copy{font-size:16px;line-height:1.55;max-width:360px}
    .hero-actions{gap:17px}
    .phone{font-size:14px}
    .founder-chip{margin-top:28px}
    .proof-strip{padding:23px 18px;display:block}
    .google-proof{margin-bottom:22px}
    .proof-clients{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .section-heading{margin-bottom:34px}
    .section-heading h2,.reviews-head h2{font-size:29px}
    .project{grid-template-columns:1fr;gap:30px;padding:43px 0}
    .project.reverse .project-visual{order:0}
    .project-copy h3{font-size:27px}
    .project-copy>p:not(.project-label){font-size:16px}
    .about.section{padding:70px 20px}
    .about-inner{grid-template-columns:1fr;gap:34px}
    .about-photo{height:auto;aspect-ratio:1/1;object-position:center 30%}
    .about-copy h2{font-size:29px}
    .about-lead{font-size:16px}
    .about-points{grid-template-columns:1fr;gap:10px}
    .about-points div{padding:18px}
    .services{padding-top:82px}
    .service-grid{grid-template-columns:1fr;gap:14px}
    .service-grid article{padding:26px}
    .service-icon{margin-bottom:28px}
    .process-grid{grid-template-columns:1fr;gap:12px;margin-top:36px}
    .process-grid article{min-height:0;padding:24px}
    .process-grid h3{margin:26px 0 11px}
    .reviews-head{align-items:flex-start}
    .reviews-head a{display:none}
    .review-grid{grid-template-columns:1fr;gap:12px}
    .review-grid blockquote,.rating{min-height:215px;padding:28px}
    .closing-cta{min-height:470px;padding:100px 22px}
    .closing-cta h2{font-size:32px}
    .closing-cta p{font-size:16px}
  }

  @media(min-width:801px){
    .hero{min-height:750px;padding-top:108px;padding-bottom:92px}
    .hero h1{font-size:clamp(52px,5.4vw,78px);margin-bottom:30px}
    .hero-copy{max-width:670px;margin-bottom:34px}
    .founder-chip{margin-top:40px}
    .proof-strip{min-height:126px;padding-top:30px;padding-bottom:30px}
    .section-heading{margin-bottom:58px}
    .project{gap:76px;padding-top:76px;padding-bottom:76px}
    .about-photo{height:580px}
    .process-grid article{min-height:310px}
    .review-grid blockquote,.rating{min-height:265px}
  }

  @media(max-width:800px){.proof-strip{min-height:0}.project-visual[data-pointer-tilt]{perspective:none}.project-visual[data-pointer-tilt] .project-visual-inner{transform:none;transition:none}}

  @media(hover:none),(pointer:coarse){.project-visual[data-pointer-tilt]{perspective:none}.project-visual[data-pointer-tilt] .project-visual-inner{transform:none;transition:none}}

  @media(prefers-reduced-motion:reduce){.project-visual[data-pointer-tilt]{perspective:none}.project-visual[data-pointer-tilt] .project-visual-inner{transform:none;transition:none}}

  @media(prefers-reduced-motion:no-preference){.hero>p,.hero>h1,.hero-actions,.founder-chip{animation:appear .55s cubic-bezier(.16,1,.3,1) both}.hero>h1{animation-delay:.06s}.hero-copy{animation-delay:.12s}.hero-actions{animation-delay:.18s}.founder-chip{animation-delay:.24s}@keyframes appear{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}}
</style>

<script>
  const reducePointerMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const canTilt = window.matchMedia("(hover: hover) and (pointer: fine)");

  if (!reducePointerMotion.matches && canTilt.matches) {
    document.querySelectorAll(".project-visual[data-pointer-tilt]").forEach((target) => {
      let pointerFrame = 0;
      let pointerX = 0;
      let pointerY = 0;

      const renderPointerTilt = () => {
        pointerFrame = 0;
        target.style.setProperty("--pointer-rx", `${pointerY * 2.5}deg`);
        target.style.setProperty("--pointer-ry", `${pointerX * -2.5}deg`);
        target.style.setProperty("--pointer-x", `${pointerX * -3}px`);
        target.style.setProperty("--pointer-y", `${pointerY * -3}px`);
      };

      const queuePointerTilt = () => {
        if (!pointerFrame) pointerFrame = requestAnimationFrame(renderPointerTilt);
      };

      target.addEventListener("pointermove", (event) => {
        const rect = target.getBoundingClientRect();
        pointerX = Math.max(-1, Math.min(1, ((event.clientX - rect.left) / rect.width) * 2 - 1));
        pointerY = Math.max(-1, Math.min(1, ((event.clientY - rect.top) / rect.height) * 2 - 1));
        target.classList.add("is-pointer-active");
        queuePointerTilt();
      });

      const resetPointerTilt = () => {
        if (pointerFrame) cancelAnimationFrame(pointerFrame);
        pointerFrame = 0;
        pointerX = 0;
        pointerY = 0;
        target.classList.remove("is-pointer-active");
        renderPointerTilt();
      };

      target.addEventListener("pointerleave", resetPointerTilt);
      target.addEventListener("pointercancel", resetPointerTilt);
    });
  }
</script>
