  /* ---- Motion: hero load fade-up; text reveals rise, images settle ---- */
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { opacity: 0; animation: studio-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .hero-copy h1 { animation-delay: 0.06s; }
    .hero-copy .lead { animation-delay: 0.12s; }
    .hero-copy .hero-cta { animation-delay: 0.18s; }
    .hero-visual { opacity: 0; animation: studio-settle 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both; }
  }
  @keyframes studio-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes studio-settle { from { opacity: 0; transform: translateY(16px) scale(0.985); } to { opacity: 1; transform: none; } }

  /* Reveal enhances an already-visible default: content hides only once JS adds
     .reveal; no-JS / reduced-motion / headless keep everything fully visible.
     Text rises; screenshot figures settle with a slight scale - two materials,
     not one uniform reflex. */
  :global(.reveal) .rv {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .rv.in { opacity: 1; transform: none; }
  :global(.reveal) figure.rv,
  :global(.reveal) .proof-visual.rv {
    transform: translateY(16px) scale(0.985);
    transition-duration: 0.8s;
  }
  :global(.reveal) .stagger > * {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .stagger.in > * { opacity: 1; transform: none; }
  :global(.reveal) .stagger.in > *:nth-child(2) { transition-delay: 0.06s; }
  :global(.reveal) .stagger.in > *:nth-child(3) { transition-delay: 0.12s; }
  :global(.reveal) .stagger.in > *:nth-child(4) { transition-delay: 0.18s; }
  :global(.reveal) .stagger.in > *:nth-child(5) { transition-delay: 0.24s; }
  :global(.reveal) .stagger.in > *:nth-child(6) { transition-delay: 0.3s; }
  :global(.reveal) .stagger.in > *:nth-child(7) { transition-delay: 0.36s; }
  :global(.reveal) .stagger.in > *:nth-child(8) { transition-delay: 0.42s; }

  /* ---- Responsive ---- */
