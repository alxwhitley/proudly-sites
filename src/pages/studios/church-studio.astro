</style>

<script>
  // Gated scroll reveal, same contract as the services cluster.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduce.matches) {
    document.documentElement.classList.add("reveal");
    const els = document.querySelectorAll(".rv, .stagger");
    const show = (el: Element) => el.classList.add("in");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { show(entry.target); io.unobserve(entry.target); }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden if the observer can't fire
      // (background tab, headless renderer, throttled JS). Reveal all after a beat.
      setTimeout(() => els.forEach(show), 1500);
    } else {
      els.forEach(show);
    }
  }

  // Dedicated Church Studio inquiry form: JS enhances to an inline success state;
  // native POST to Web3Forms is the no-JS fallback.
  const form = document.getElementById("studio-form") as HTMLFormElement | null;
  const success = document.getElementById("studio-form-success");
  const errorEl = document.getElementById("studio-form-error");

  if (form && success && errorEl) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = btn ? btn.textContent : "";
      if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
      errorEl.hidden = true;

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await res.json();
        if (res.ok && data.success) {
          form.hidden = true;
          success.hidden = false;
          (success as HTMLElement).focus();
        } else {
          throw new Error(data.message || "Request failed");
        }
      } catch (err) {
        errorEl.hidden = false;
        if (btn) { btn.disabled = false; btn.textContent = label; }
      }
    });
  }
</script>
