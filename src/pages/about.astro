---
import BaseLayout from "../layouts/BaseLayout.astro";

const testimonials = [
  ["“Alex was so helpful in creating a website for our ministry. For anyone trying to go beyond generic sites, I would highly recommend.”", "Josh F.", "After Hours Ministry"],
  ["“Working with Alex on our law firm website was a great experience from start to finish. Thoughtful, professional, and highly receptive to feedback.”", "Kelly S.", "Smith Cash Law"],
  ["“The design looks amazing, the site runs smoothly, and everything was completed on time.”", "Tony R.", "Legacy Renovations"],
];
---

<BaseLayout
  title="About · Proudly Sites"
  description="Proudly Sites is a one-person web design studio in Raleigh, run by Alex Whitley. Strategy, copy, design, and build from one accountable person, start to finish."
>
  <section class="section about-hero">
    <!--
      THESIS: make the one-person model read as an asset, not a risk; refuse the agency "About us" team-grid and stock-values template.
      OWN-WORLD: the homepage's Grounded Workshop, inherited whole - Warm Cream ground, Espresso Black close, Playfair editorial headings on Lato text, Honey Gold decorating only, one Burnt Terracotta stacked-shadow CTA.
      STORY: a skeptical, referred founder reads why Proudly exists, how Alex works, and the honest answer to "is one person enough," then takes the ask.
      FIRST VIEWPORT: two columns - H1 "The Person Behind Your Project" plus a short lead left, Alex's real 4:5 headshot right; the primary action waits at the close.
      FORM: established-world extension (no concept roll). Reshaped 2026-08-07: the old build ran three consecutive single-column text blocks (Story, Principles, Question) with no structural break between them. New grammar - asymmetric split (Story), a standalone full-width thesis band (Oat), a photo-split (Principles, alternating side from the hero), then Question stands alone as the one deliberate minimal beat. Principles photo is an on-palette placeholder pending Alex's real workspace shot - swap before ship, see assets.md.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
    -->
    <div class="hero-copy">
      <h1>The Person Behind Your Project</h1>
      <p class="lead">I&rsquo;m Alex Whitley, and Proudly Sites is a one-person web design studio in Raleigh. If we work together, this page is who you&rsquo;re working with. All of it.</p>
    </div>
    <img
      class="hero-photo"
      src="/images/alex-whitley.jpeg"
      width="520"
      height="650"
      alt="Alex Whitley, founder of Proudly Sites"
    />
  </section>

  <div class="surface-white">
    <section class="section story">
      <div class="story-grid">
        <div class="story-head rv">
          <h2>Great businesses, stuck with websites beneath their work</h2>
        </div>
        <div class="story-body">
          <p class="rv">Every business I admire has the same gap. The work is excellent. The reputation is real. Clients rave, referrals come in, and then those referrals land on a website that looks like it was set up in a weekend years ago and never touched again.</p>
          <p class="rv">That gap is the whole reason Proudly Sites exists. Not because businesses need more leads or better funnels.</p>
          <p class="rv">I build sites for businesses that win on reputation. The kind where someone already said &ldquo;you should call them,&rdquo; and the site&rsquo;s only job is to confirm they were right.</p>
        </div>
      </div>
    </section>
  </div>

  <div class="surface-oat">
    <section class="section thesis">
      <p class="thesis-line rv">A referral is a moment of trust, and the website is where that trust either holds or hesitates.</p>
    </section>
  </div>

  <section class="section principles">
    <div class="principles-head rv">
      <h2>Three things I won&rsquo;t compromise on</h2>
    </div>
    <div class="principles-grid">
      <figure class="principles-visual rv">
        <div class="ph-panel" role="img" aria-label="Alex at work in his studio - real photo pending">
          <span>Alex, at work</span>
          <small>Real photo pending</small>
        </div>
      </figure>
      <ol class="principle-list stagger">
        <li class="principle">
          <span class="principle-num" aria-hidden="true">1</span>
          <div>
            <h3>Strategy before design</h3>
            <p>Before anything gets styled, we get clear on who your clients are, what they need to believe, and what your site has to prove. A beautiful site built on a wrong assumption is still a wrong site.</p>
          </div>
        </li>
        <li class="principle">
          <span class="principle-num" aria-hidden="true">2</span>
          <div>
            <h3>One person, start to finish</h3>
            <p>The person on your discovery call writes your copy, designs your pages, builds the site, and answers your emails. Nothing gets lost in a handoff because there are no handoffs.</p>
          </div>
        </li>
        <li class="principle">
          <span class="principle-num" aria-hidden="true">3</span>
          <div>
            <h3>Reputation assets, not lead machines</h3>
            <p>I don&rsquo;t build funnels. I build sites that make the trust you&rsquo;ve already earned visible, so every referral arrives and thinks &ldquo;yes, this is what I was told.&rdquo;</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <div class="cred">
    <div class="cred-inner">
      <span>Based in Raleigh, NC</span>
      <span class="cred-reviews"><span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>Rated 5.0 on Google Reviews</span>
      <span>5 years in business</span>
    </div>
  </div>

  <div class="surface-white">
    <section class="section testimonials">
      <div class="testimonials-head rv"><h2>What Clients Say</h2></div>
      <div class="review-grid">
        {testimonials.map(item => <blockquote><span>★★★★★</span><p>{item[0]}</p><cite><b>{item[1]}</b>{item[2]}</cite></blockquote>)}
      </div>
    </section>
  </div>

  <div class="surface-dark">
    <section class="section closing rv">
      <div class="closing-copy">
        <h2>Your Work Deserves a Website That Proves It</h2>
        <p>Send a message about your business. You&rsquo;ll hear back from me, not a sales team, within a day, with honest advice on whether a new site is even the right move.</p>
        <a class="primary-button" href="/contact">Let&rsquo;s Work Together</a>
        <p class="closing-sub">Live in weeks, not months.</p>
      </div>
      <aside class="alex-card">
        <img
          class="alex-card-photo"
          src="/images/alex-whitley.jpeg"
          width="64"
          height="64"
          loading="lazy"
          alt=""
        />
        <p class="alex-card-name">Alex Whitley</p>
        <p class="alex-card-role">Founder, Proudly Sites. Every project, start to finish, is mine.</p>
        <p class="alex-card-anchor">Member, Triangle Christian Chamber of Commerce</p>
      </aside>
    </section>
  </div>
</BaseLayout>

<style>
  /* Route-specific composition for /about. Tokens + chrome are global. */

  /* ---- Full-bleed surface bands ---- */
  .surface-white { background: var(--white); }
  .surface-oat { background: var(--oat); }
  .surface-dark { background: var(--espresso); color: #fff; }

  /* ---- Hero ---- */
  .section.about-hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
    padding-top: clamp(56px, 7vw, 104px);
    padding-bottom: clamp(64px, 7vw, 120px);
  }
  .about-hero h1 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0 0 22px;
  }
  .about-hero .lead {
    font-size: 20px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--muted);
    margin: 0;
    max-width: 30rem;
  }
  .hero-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 28%;
    border-radius: 14px;
    border: 1px solid var(--line);
  }

  /* ---- Story: asymmetric two-column, sticky head ---- */
  .story-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(36px, 5vw, 84px);
    align-items: start;
  }
  .story-head { position: sticky; top: 110px; }
  .story-head h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 3.6vw, 40px);
    line-height: 1.16;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .story-body { max-width: 36rem; }
  .story-body p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--muted);
    margin: 0 0 22px;
  }
  .story-body p:last-child { margin-bottom: 0; }

  /* ---- Thesis: standalone full-width pullquote band on Oat ---- */
  .section.thesis {
    max-width: 920px;
    padding-top: clamp(64px, 8vw, 112px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .thesis-line {
    font-family: "Playfair Display", Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(24px, 4vw, 36px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--espresso);
    margin: 0;
    max-width: 22ch;
  }

  /* ---- Principles: photo-split (alternates side from hero), numbered list ---- */
  .principles-head { margin-bottom: 44px; }
  .principles-head h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 3.6vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .principles-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(36px, 5vw, 72px);
    align-items: start;
  }
  .principles-visual {
    position: sticky;
    top: 96px;
    margin: 0;
    background: var(--sand);
    border-radius: 16px;
    padding: clamp(18px, 2vw, 26px);
  }
  .ph-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    aspect-ratio: 4 / 5;
    background: var(--oat);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-align: center;
    padding: 24px;
  }
  .ph-panel span {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 20px;
    color: var(--espresso);
  }
  .ph-panel small {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6d635c;
  }
  .principle-list { list-style: none; margin: 0; padding: 0; }
  .principle {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 24px;
    align-items: start;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }
  .principle-list li:last-child { border-bottom: 1px solid var(--line); }
  .principle-num {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 32px;
    line-height: 1;
    color: #6d635c;
  }
  .principle h3 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .principle p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
    max-width: 46ch;
  }

  /* ---- Testimonials: index.astro's review-grid card pattern, reused as-is ---- */
  .testimonials-head { margin-bottom: 44px; }
  .testimonials-head h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 3.6vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .review-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .review-grid blockquote {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    min-height: 245px;
    padding: 34px;
  }
  .review-grid blockquote > span { color: var(--gold); letter-spacing: 0.1em; font-size: 12px; }
  .review-grid blockquote p {
    font: 500 20px/1.4 "Playfair Display", serif;
    margin: 20px 0 27px;
  }
  .review-grid cite { font-style: normal; font-size: 12px; color: #6d635c; }
  .review-grid cite b { display: block; color: var(--espresso); font-size: 14px; }

  /* ---- Trust bar ---- */
  .cred {
    background: var(--cream);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .cred-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 28px 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px 48px;
    font-size: 14px;
    color: var(--muted);
  }
  .cred-inner span { white-space: nowrap; }
  .cred-reviews {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--espresso);
  }
  .stars { color: var(--gold); letter-spacing: 2px; }

  /* ---- Closing CTA (dark, two-column) ---- */
  .section.closing {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: center;
    /* Footer is also espresso; trim the section's own padding so the two dark
       bands don't stack into an oversized void before the footer columns. */
    padding-top: clamp(72px, 8vw, 120px);
    padding-bottom: clamp(52px, 6vw, 92px);
  }
  .closing-copy h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 3.4vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 0 0 20px;
  }
  .closing-copy p {
    font-size: 20px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    margin: 0 0 30px;
    max-width: 34rem;
  }
  .closing-sub {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    margin: 20px 0 0;
  }
  .alex-card {
    background: var(--dark-card);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .alex-card-photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 28%;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .alex-card-name { font-size: 16px; font-weight: 700; color: #fff; margin: 0; }
  .alex-card-role {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }
  .alex-card-anchor {
    width: 100%;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 14px;
    margin: 6px 0 0;
  }

  /* ---- Motion: one authored load moment + scroll reveal ---- */
  @media (prefers-reduced-motion: no-preference) {
    .about-hero .hero-copy > *,
    .about-hero .hero-photo {
      opacity: 0;
      animation: about-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .about-hero .hero-copy .lead { animation-delay: 0.08s; }
    .about-hero .hero-photo { animation-delay: 0.16s; }
  }
  @keyframes about-rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  /* Scroll reveal is gated behind the JS-added .reveal class so content stays
     visible with no JS and under reduced motion (the script skips both).
     Text rises; the principles photo settles with a slight scale instead of
     the identical uniform rise - two materials, not one. */
  :global(.reveal) .rv {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .rv.in { opacity: 1; transform: none; }
  :global(.reveal) .principles-visual.rv {
    transform: translateY(16px) scale(0.985);
    transition-duration: 0.8s;
  }
  :global(.reveal) .stagger > * {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .stagger.in > * { opacity: 1; transform: none; }
  :global(.reveal) .stagger.in > *:nth-child(2) { transition-delay: 0.08s; }
  :global(.reveal) .stagger.in > *:nth-child(3) { transition-delay: 0.16s; }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .story-grid,
    .principles-grid {
      grid-template-columns: 1fr;
    }
    .story-head,
    .principles-visual { position: static; }
  }
  @media (max-width: 800px) {
    .section.about-hero {
      grid-template-columns: 1fr;
      gap: 30px;
      padding-top: 40px;
      padding-bottom: 8px;
    }
    .about-hero .lead { font-size: 16px; }
    .hero-photo { max-width: 280px; }

    .story-grid { gap: 24px; }
    .thesis-line { max-width: none; }

    .principles-visual { max-width: 280px; margin: 0 auto; }
    .principle { grid-template-columns: auto 1fr; gap: 18px; padding: 28px 0; }
    .principle-num { font-size: 24px; }

    .section.closing { grid-template-columns: 1fr; gap: 30px; }
    .closing-copy p { font-size: 16px; }

    .review-grid { grid-template-columns: 1fr; gap: 12px; }
    .review-grid blockquote { min-height: 0; padding: 28px; }

    .cred-inner {
      justify-content: flex-start;
      gap: 12px 26px;
      padding: 22px 20px;
    }
  }
</style>

<script>
  // Gated scroll reveal, same contract as the Studios/Services cluster.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduce.matches) {
    document.documentElement.classList.add("reveal");
    const els = document.querySelectorAll(".rv, .stagger");
    const show = (el: Element) => el.classList.add("in");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              show(entry.target);
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      els.forEach((el) => io.observe(el));
      // Safety net: never leave content hidden if the observer can't fire
      // (background tab, headless renderer, throttled JS). Reveal all after a beat.
      setTimeout(() => els.forEach(show), 1500);
    } else {
      els.forEach(show);
    }
  }
</script>
