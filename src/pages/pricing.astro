---
/*
  Pricing route (/pricing). Persuade surface, extension of the homepage's
  "Grounded Workshop" world. A two-column hero mirrors /contact's composition:
  copy and a hairline price ledger on the left, a single flat white form card on
  the right. Below that, a short testimonial row and an FAQ carry the remaining
  detail. The inquiry form posts to Web3Forms; JS enhances to an inline success
  state, native POST is the no-JS fallback. Route-specific composition lives
  here; shared chrome + tokens come from BaseLayout / global.css.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import InquiryForm from "../components/InquiryForm.astro";

const faqs = [
  {
    q: "How much does a website cost from Proudly Sites?",
    a: "Most projects land between $4,000 and $8,000. Larger or more involved projects, like a full restructure or a custom booking system, run $10,000 and up. Every project is scoped and priced before you commit, so you'll know your number going in.",
  },
  {
    q: "What decides where my project lands in that range?",
    a: [
      "Page count. A tighter site costs less than one built to cover every service and location you offer.",
      "Starting point. A rebuild of what you already have costs less than a full restructure built around new research into what people are searching for.",
      "Forms and backend. Simple contact and inquiry forms are part of most projects. Booking systems, custom calculators, and anything wired to a live backend add scope.",
    ],
  },
  {
    q: "What's included in every project?",
    a: [
      "All copy written for you, for every page. You review and approve, you don't write anything.",
      "Keyword research before anything is designed, plus complete on-page SEO: titles, headings, meta descriptions, image alt text, and internal linking.",
      "Unlimited revision rounds until you're happy with what's built.",
      "Domain transfer handled for you, with your search rankings preserved through the move.",
      "One person on the work, start to finish. No handoffs to a junior designer or an offshore team.",
    ],
  },
  {
    q: "Do you charge by the hour?",
    a: "No. Every project is a flat, agreed price set before work begins. There's no hourly rate and no per-page rate card.",
  },
  {
    q: "How long does it take?",
    a: "Roughly a week from confirmed scope to launch.",
  },
  {
    q: "What does ongoing maintenance cost?",
    a: [
      "Two plans, both month to month.",
      {
        heading: "Care Plan, $120 a month:",
        items: [
          "Hosting, SSL, and platform costs, fully handled",
          "Unlimited text and photo updates: swap copy, update photos, change rates or dates, add an announcement, whenever you need",
          "Ongoing maintenance, security updates, and uptime monitoring",
          "Direct support by email or text, typical turnaround 1 to 2 business days",
        ],
      },
      {
        heading: "Growth Plan, $350 a month. Everything in Care, plus:",
        items: [
          "Monthly search performance reporting, and a quarterly call to review what's working and set next quarter's priorities",
          "Ongoing keyword research as your services and seasons change",
          "On-page optimization for new and existing pages",
          "Google Business Profile management: posts, photos, review monitoring, hours and service updates",
          "One new written page or article added to your site every month",
        ],
      },
    ],
  },
  {
    q: "Do I need a contract?",
    a: "No. Care and Growth are both month to month. Cancel any time with 30 days' notice, and your site and domain stay yours. Your rates hold for your first 12 months.",
  },
  {
    q: "Will I be able to edit the site myself?",
    a: "By default, updates are handled for you. You send changes, they get made. If you'd rather have direct access to edit the site yourself, that's available too. Just let me know and it's part of your plan.",
  },
];

const testimonials = [
  {
    quote: "Working with Alex on our law firm website was a great experience from start to finish. Thoughtful, professional, and highly receptive to feedback.",
    cite: "Kelly S., Smith Cash Law",
  },
  {
    quote: "The design looks amazing, the site runs smoothly, and everything was completed on time.",
    cite: "Tony R., Legacy Renovations",
  },
  {
    quote: "Alex was so helpful in creating a website for our ministry. For anyone trying to go beyond generic sites, I would highly recommend.",
    cite: "Josh F., After Hours Ministry",
  },
];

// Service schema: priceRange numbers must stay in lockstep with the hero ledger
// and the FAQ's first answer ("$4,000 and $8,000"). Update all together if the
// band ever changes.
const pageUrl = new URL("/pricing", Astro.site).toString();
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Custom Website Design & Development",
  provider: {
    "@type": "Organization",
    name: "Proudly Sites",
    url: Astro.site?.toString() ?? "https://proudlysites.com",
  },
  description: "Custom-built, flat-priced websites for reputation-led service businesses, scoped and priced before any work begins.",
  priceRange: "$4,000-$8,000",
  url: pageUrl,
};
---

<BaseLayout
  title="Pricing · Proudly Sites"
  description="What a Proudly Sites project costs. Most projects land between $4,000 and $8,000, scoped and priced before you commit."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <section class="section pricing">
    <div class="pricing-grid">
      <aside class="pricing-aside">
        <h1>Every project gets its own number.</h1>
        <p class="lead">Your business isn't the one down the street, and your site shouldn't be priced like it is. Every project is scoped and priced before you commit, so you know your number before any work starts.</p>

        <ul class="price-ledger">
          <li>
            <span class="ledger-label">Most projects</span>
            <span class="ledger-value">$4,000 to $8,000</span>
          </li>
          <li>
            <span class="ledger-label">Larger builds</span>
            <span class="ledger-value">$10,000 and up</span>
            <span class="ledger-caption">Full restructures, custom booking systems, and sites built to serve several audiences at once.</span>
          </li>
        </ul>

        <p class="pricing-note">Page count, how much of your current site can be reused, and whether you need booking or other backend work are what move it. The questions below cover the rest.</p>
      </aside>

      <div class="pricing-form-card">
        <h2 class="form-title">Get a price for your project</h2>
        <p class="form-sub">Send a few details and you'll get a number and next steps back, not a form that disappears into a queue.</p>

        <InquiryForm subject="New inquiry from proudlysites.com/pricing" fromName="Proudly Sites website - Pricing page">
          <div class="field">
            <label for="pf-name">Name <span class="req" aria-hidden="true">*</span></label>
            <input id="pf-name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="pf-email">Email <span class="req" aria-hidden="true">*</span></label>
              <input id="pf-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
            </div>
            <div class="field">
              <label for="pf-phone">Phone <span class="optional">optional</span></label>
              <input id="pf-phone" name="phone" type="tel" autocomplete="tel" placeholder="(919) 000-0000" />
            </div>
          </div>

          <div class="field">
            <label for="pf-need">What do you need? <span class="req" aria-hidden="true">*</span></label>
            <select id="pf-need" name="need" required>
              <option value="" disabled selected>Choose one</option>
              <option value="A new website">A new website</option>
              <option value="A redesign of my current site">A redesign of my current site</option>
              <option value="Not sure yet, let's talk">Not sure yet, let's talk</option>
            </select>
          </div>

          <div class="field">
            <label for="pf-message">Message <span class="req" aria-hidden="true">*</span></label>
            <textarea id="pf-message" name="message" rows="5" required placeholder="Tell me about your business and what you're looking for."></textarea>
          </div>
        </InquiryForm>
      </div>
    </div>
  </section>

  <section class="section testimonials">
    <h2 class="rv">What clients say</h2>
    <div class="testimonial-grid stagger">
      {testimonials.map((t) => (
        <figure class="testimonial">
          <blockquote>"{t.quote}"</blockquote>
          <figcaption>- {t.cite}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section pricing-faq">
    <h2 class="rv">FAQ</h2>
    <div class="faq-list stagger">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          {Array.isArray(f.a) ? (
            <ul>
              {f.a.map((item) => (
                typeof item === "string" ? (
                  <li>{item}</li>
                ) : (
                  <li class="plan-tier">
                    {item.heading}
                    <ul>
                      {item.items.map((sub) => (
                        <li>{sub}</li>
                      ))}
                    </ul>
                  </li>
                )
              ))}
            </ul>
          ) : (
            <p>{f.a}</p>
          )}
        </details>
      ))}
    </div>
  </section>

  <p class="pricing-closer">Still have a question? Email <a href="mailto:alex@proudlysites.com">alex@proudlysites.com</a> or send it through the form above.</p>
</BaseLayout>

<style>
  /* Route-specific composition for /pricing. Tokens + chrome are global. */
  .section.pricing {
    padding-top: 120px;
    padding-bottom: 100px;
    max-width: 1180px;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 60px;
    align-items: start;
  }

  /* ---- Left: copy + price ledger ---- */
  .pricing-aside { padding-top: 6px; }
  .pricing-aside h1 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
  }
  .pricing-aside .lead {
    font-size: 20px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: var(--muted);
    margin: 0 0 34px;
  }

  .price-ledger { list-style: none; margin: 0 0 34px; padding: 0; }
  .price-ledger li {
    display: grid;
    gap: 6px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .price-ledger li:last-child { border-bottom: 1px solid var(--line); }
  .ledger-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6d635c;
  }
  .ledger-value {
    font: 500 clamp(24px, 2.4vw, 32px)/1.1 "Fraunces", Georgia, serif;
    letter-spacing: -0.02em;
    color: var(--espresso);
  }
  .ledger-caption {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 36ch;
    margin-top: 8px;
  }

  .pricing-note {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 38ch;
  }

  /* ---- Right: the form card ---- */
  .pricing-form-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 40px;
  }
  .form-title {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .form-sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 24px;
  }

  /* ---- Testimonials ---- */
  .section.testimonials {
    padding-top: 0;
    padding-bottom: 100px;
    max-width: 1180px;
  }
  .testimonials h2 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    margin: 0 0 28px;
  }
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .testimonial {
    margin: 0;
    padding: 28px clamp(24px, 3vw, 36px);
  }
  .testimonial:not(:last-child) { border-right: 1px solid var(--line); }
  .testimonial blockquote {
    font-size: 16px;
    line-height: 1.65;
    color: var(--espresso);
    margin: 0 0 16px;
  }
  .testimonial figcaption {
    font-size: 14px;
    color: #6d635c;
  }

  /* ---- FAQ: reuses the site's existing <details>/<summary> disclosure pattern. ---- */
  .section.pricing-faq {
    padding-top: 0;
    padding-bottom: 100px;
    max-width: 760px;
  }
  .pricing-faq h2 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    margin: 0 0 28px;
  }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item summary {
    position: relative;
    cursor: pointer;
    list-style: none;
    padding: 20px 40px 20px 0;
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--espresso);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: "+";
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 20px;
    font-weight: 300;
    color: #6d635c;
    transition: transform 0.25s ease;
  }
  .faq-item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq-item p,
  .faq-item ul {
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
    padding: 0 40px 22px 0;
  }
  .faq-item ul { list-style: disc; padding-left: 1.2em; }
  .faq-item li { margin-bottom: 8px; }
  .faq-item li:last-child { margin-bottom: 0; }
  .faq-item ul ul { margin-top: 8px; padding-bottom: 0; }
  .faq-item ul ul li { margin-bottom: 6px; }

  /* Care/Growth are comparable tiers, not two more bullets in the list:
     separate each with a hairline + generous top space so they read as
     distinct, parallel groups instead of blending into the surrounding list. */
  .faq-item li.plan-tier {
    list-style: none;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  /* ---- Closer ---- */
  .pricing-closer {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px 120px;
    text-align: center;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }
  .pricing-closer a { color: var(--espresso); text-decoration: underline; }

  /* ---- Motion: one authored load moment, matching /contact ---- */
  @media (prefers-reduced-motion: no-preference) {
    .pricing-aside, .pricing-form-card {
      animation: pricing-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .pricing-form-card { animation-delay: 0.1s; }
  }
  @keyframes pricing-rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  /* ---- Motion: scroll reveal for the testimonials + FAQ sections below the fold ---- */
  :global(.reveal) .rv {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .rv.in { opacity: 1; transform: none; }
  :global(.reveal) .stagger > * {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.reveal) .stagger.in > * { opacity: 1; transform: none; }
  :global(.reveal) .stagger.in > *:nth-child(2) { transition-delay: 0.06s; }
  :global(.reveal) .stagger.in > *:nth-child(3) { transition-delay: 0.12s; }
  :global(.reveal) .stagger.in > *:nth-child(4) { transition-delay: 0.18s; }
  /* FAQ list runs to 8 items; cap the cascade instead of letting it grow another 8 steps. */
  :global(.reveal) .stagger.in > *:nth-child(5) { transition-delay: 0.24s; }
  :global(.reveal) .stagger.in > *:nth-child(n+6) { transition-delay: 0.24s; }

  /* ---- Responsive ---- */
  @media (max-width: 800px) {
    .section.pricing { padding-top: 64px; padding-bottom: 64px; }
    .pricing-aside .lead { font-size: 16px; }
    .pricing-grid { display: flex; flex-direction: column; align-items: stretch; gap: 32px; }
    .pricing-form-card { padding: 26px 22px; }

    .section.testimonials { padding-bottom: 64px; }
    .testimonials h2 { margin-bottom: 22px; }
    .testimonial-grid { grid-template-columns: 1fr; }
    .testimonial { padding: 24px 0; }
    .testimonial:not(:last-child) { border-right: none; border-bottom: 1px solid var(--line); }

    .section.pricing-faq { padding-bottom: 64px; }
    .faq-item summary { font-size: 17px; }
    .faq-item p,
    .faq-item ul { padding-right: 0; }

    .pricing-closer { padding-bottom: 80px; font-size: 16px; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (!reduce.matches) {
    document.documentElement.classList.add("reveal");
    const els = document.querySelectorAll(".rv, .stagger");
    const show = (el) => el.classList.add("in");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { show(entry.target); io.unobserve(entry.target); }
        });
      }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
      els.forEach((el) => io.observe(el));
      setTimeout(() => els.forEach(show), 1500);
    } else {
      els.forEach(show);
    }
  }
</script>
