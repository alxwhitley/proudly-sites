  /* ---- Motion: one authored load moment on the hero, matching /contact ---- */
  @media (prefers-reduced-motion: no-preference) {
    .pricing-hero .pricing-measure > * {
      opacity: 0;
      animation: pricing-rise 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .pricing-hero h1 { animation-delay: 0.06s; }
    .pricing-hero .lead { animation-delay: 0.13s; }
  }
  @keyframes pricing-rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
